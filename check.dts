	chosen {
		systemd.debug_shell = "ttyS0";
		stdout-path = "serial2:1500000n8";
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0xaa 0x00 0x61a8 0x00>;
		brightness-levels = <0x00 0xff>;
		default-brightness-level = <0x80>;
		phandle = <0x95>;
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x2dc6c0>;
		charge-term-current-microamp = <0x30d40>;
		constant-charge-current-max-microamp = <0x16e360>;
		constant-charge-voltage-max-microvolt = <0x401640>;
		factory-internal-resistance-micro-ohms = <0x186a0>;
		voltage-max-design-microvolt = <0x3e8fa0>;
		voltage-min-design-microvolt = <0x325aa0>;
		ocv-capacity-celsius = <0x14>;
		ocv-capacity-table-0 = <0x3dc066 0x64 0x3d1080 0x5f 0x3c8b9c 0x5a 0x3c1ea0 0x55 0x3ba970 0x50 0x3b0d30 0x4b 0x3a70f0 0x46 0x39d4b0 0x41 0x393870 0x3c 0x38c340 0x37 0x384e10 0x32 0x37b1d0 0x2d 0x3763b0 0x28 0x367950 0x23 0x360420 0x1e 0x3567e0 0x19 0x34cba0 0x14 0x342f60 0x0f 0x339320 0x0a 0x32f6e0 0x05 0x325aa0 0x00>;
		phandle = <0x5b>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <0xab 0x02>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x3c>;
		phandle = <0x13d>;

		vol-down-key {
			label = "VOLUMEDOWN";
			linux,code = <0x72>;
			press-threshold-microvolt = <0x445c0>;
		};

		vol-up-key {
			label = "VOLUMEUP";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x3a98>;
		};
	};

	rocknix-singleadc-joypad {
		compatible = "rocknix-singleadc-joypad";
		joypad-name = "retrogame_joypad";
		joypad-product = <0x1101>;
		joypad-revision = <0x100>;
		joypad-vendor = <0x484b>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0xac>;
		io-channel-names = "amux_adc";
		io-channels = <0xab 0x01>;
		amux-count = <0x04>;
		amux-channel-mapping = <0x02 0x03 0x01 0x00>;
		amux-a-gpios = <0xad 0x10 0x01>;
		amux-b-gpios = <0xad 0x0f 0x00>;
		rumble-gpio = <0x96 0x06 0x01>;
		button-adc-scale = <0x02>;
		button-adc-deadzone = <0x40>;
		button-adc-fuzz = <0x20>;
		button-adc-flat = <0x20>;
		abs_x-p-tuning = <0xc8>;
		abs_x-n-tuning = <0xc8>;
		abs_y-p-tuning = <0xc8>;
		abs_y-n-tuning = <0xc8>;
		abs_rx-p-tuning = <0xc8>;
		abs_rx-n-tuning = <0xc8>;
		abs_ry-p-tuning = <0xc8>;
		abs_ry-n-tuning = <0xc8>;
		poll-interval = <0x0a>;
		invert-absx;
		invert-absy;
		phandle = <0x13e>;

		sw1 {
			gpios = <0x96 0x16 0x01>;
			label = "GPIO DPAD-UP";
			linux,code = <0x220>;
		};

		sw2 {
			gpios = <0x96 0x17 0x01>;
			label = "GPIO DPAD-DOWN";
			linux,code = <0x221>;
		};

		sw3 {
			gpios = <0x96 0x14 0x01>;
			label = "GPIO DPAD-LEFT";
			linux,code = <0x222>;
		};

		sw4 {
			gpios = <0x96 0x15 0x01>;
			label = "GPIO DPAD-RIGHT";
			linux,code = <0x223>;
		};

		sw5 {
			gpios = <0x96 0x10 0x01>;
			label = "GPIO BTN-A";
			linux,code = <0x131>;
		};

		sw6 {
			gpios = <0x96 0x11 0x01>;
			label = "GPIO BTN_B";
			linux,code = <0x130>;
		};

		sw7 {
			gpios = <0x96 0x13 0x01>;
			label = "GPIO BTN_Y";
			linux,code = <0x134>;
		};

		sw8 {
			gpios = <0x96 0x12 0x01>;
			label = "GPIO BTN_X";
			linux,code = <0x133>;
		};

		sw9 {
			gpios = <0x96 0x18 0x01>;
			label = "BTN_SELECT";
			linux,code = <0x13a>;
		};

		sw10 {
			gpios = <0x96 0x19 0x01>;
			label = "BTN_START";
			linux,code = <0x13b>;
		};

		sw11 {
			gpios = <0x96 0x0a 0x01>;
			label = "GPIO BTN_F";
			linux,code = <0x13c>;
		};

		sw12 {
			gpios = <0xad 0x0d 0x01>;
			label = "BTN_THUMBL";
			linux,code = <0x13d>;
		};

		sw13 {
			gpios = <0xad 0x0e 0x01>;
			label = "BTN_THUMBR";
			linux,code = <0x13e>;
		};

		sw14 {
			gpios = <0x96 0x0b 0x01>;
			label = "GPIO BTN_TR";
			linux,code = <0x137>;
		};

		sw15 {
			gpios = <0x96 0x0c 0x01>;
