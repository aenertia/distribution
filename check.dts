	audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <0x96 0x07 0x00>;
		pinctrl-0 = <0xae>;
		pinctrl-names = "default";
		sound-name-prefix = "Speaker Amp";
		phandle = <0xb0>;
	};

	rk817-sound {
		compatible = "simple-audio-card";
		pinctrl-names = "default";
		pinctrl-0 = <0xaf>;
		simple-audio-card,name = "rk817_ext";
		simple-audio-card,aux-devs = <0xb0>;
		simple-audio-card,format = "i2s";
		simple-audio-card,hp-det-gpio = <0xad 0x16 0x01>;
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,widgets = "Microphone\0Mic Jack\0Headphone\0Headphones\0Speaker\0Speaker";
		simple-audio-card,routing = "MICL\0Mic Jack\0Headphones\0HPOL\0Headphones\0HPOR\0Speaker\0SPKO";

		simple-audio-card,codec {
			sound-dai = <0xb1>;
		};

		simple-audio-card,cpu {
			sound-dai = <0xb2>;
		};
	};

	vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x5a>;
	};

	vcc-phy-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_phy";
		regulator-always-on;
		regulator-boot-on;
	};

	vcc18-lcd0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc18_lcd0_n";
		gpio = <0x57 0x0d 0x00>;
		enable-active-high;
		pinctrl-0 = <0xb3>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0x98>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vcc_host {
		compatible = "regulator-fixed";
		regulator-name = "vcc_host";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x96 0x04 0x00>;
		pinctrl-0 = <0xb4>;
		pinctrl-names = "default";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <0xb5>;
		phandle = <0x13f>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-0 = <0xb6>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <0x7d0>;
		reset-gpios = <0x57 0x02 0x01>;
		phandle = <0x81>;
	};

