#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)

. /etc/profile.d/001-functions

GPU_DRIVER_SETTING_KEY="gpu.driver"

get_current_driver() {
  CONFDRIVER=$(get_setting ${GPU_DRIVER_SETTING_KEY})
  if [ -z ${CONFDRIVER} ]; then
    CONFDRIVER="libmali"              # DEFAULT
    set_setting ${GPU_DRIVER_SETTING_KEY} ${CONFDRIVER}
  fi
}

# Get the currently LOADED driver (not the configured one).
get_loaded_driver() {
  if lsmod 2>/dev/null | grep -q "^mali_kbase"; then
    echo "libmali"
  elif lsmod 2>/dev/null | grep -q "^@PAN@"; then
    echo "panfrost"
  else
    echo "none"
  fi
}

# Check if Waydroid container is active.
is_waydroid_running() {
  [ -f /var/run/waydroid-container.pid ] && kill -0 $(cat /var/run/waydroid-container.pid 2>/dev/null) 2>/dev/null
}

# When loading a driver, do two things:
#   * ensure needed driver is loaded and other is not
#   * ensure graphics related libs are overridden (or not)
load_driver() {
  DRIVER_TO_LOAD=$1

  case ${DRIVER_TO_LOAD} in
    "libmali")
      modprobe -r @PAN@
      modprobe mali_kbase

      # Bind-mount mali GLES libraries over mesa if not already done.
      # Use mount output (not /proc/mounts) to avoid squashfs false positives.
      mount | grep -q "on /usr/lib/libEGL.so" || find /usr/{lib,lib32}/mali -type f -exec bash -c 'lib={}; mount --bind $lib ${lib/\/mali\//\/}' ';'
      # Portmaster is not ready for SDL in glesonly subdir, so override libs the dirty way
      if [ -d /usr/lib/glesonly ]; then
        mount | grep -q "on /usr/lib/libSDL2" || find /usr/{lib,lib32}/glesonly -type f -exec bash -c 'lib={}; mount --bind $lib ${lib/\/glesonly\//\/}' ';'
      fi
      mount --bind /dev/null /usr/lib/libGL.so
      mount --bind /dev/null /usr/lib32/libGL.so

      # Mask panfrost Vulkan ICD so the loader only finds mali
      for icd in /usr/share/vulkan/icd.d/panfrost_icd.*.json; do
        [ -f "${icd}" ] && mount --bind /dev/null "${icd}"
      done
      ;;
    "panfrost")
      modprobe -r mali_kbase
      modprobe @PAN@

      mount | grep -q "on /usr/lib/libEGL.so" && find /usr/lib/mali -type f -exec bash -c 'lib={}; umount ${lib/\/mali\//\/}' ';'
      if [ -d /usr/lib/glesonly ]; then
        mount | grep -q "on /usr/lib/libSDL2" && find /usr/lib/glesonly -type f -exec bash -c 'lib={}; umount ${lib/\/glesonly\//\/}' ';'
      fi

      # Mask mali Vulkan ICD so the loader only finds panfrost
      [ -f /usr/share/vulkan/icd.d/mali.json ] && \
        mount --bind /dev/null /usr/share/vulkan/icd.d/mali.json
      ;;
    *)
      exit 3
      ;;
  esac
}

# Waydroid requires DRM render nodes (/dev/dri/renderD*) which only
# panfrost/panthor provide. mali_kbase exposes /dev/mali0 (miscdevice)
# which Waydroid cannot use for GPU acceleration.
#
# --waydroid-ensure: If mali_kbase is loaded, temporarily switch to
# panfrost for the duration of the Waydroid session. The configured
# default is not changed — on next boot or after Waydroid stops, the
# user's preferred driver (likely libmali) is restored.
#
# --waydroid-restore: After Waydroid stops, reload the user's configured
# driver if it was temporarily overridden.
waydroid_ensure_drm() {
  LOADED=$(get_loaded_driver)
  if [ "${LOADED}" = "libmali" ]; then
    load_driver panfrost
    touch /tmp/.gpudriver_waydroid_override
  fi
}

waydroid_restore() {
  if [ -f /tmp/.gpudriver_waydroid_override ]; then
    rm -f /tmp/.gpudriver_waydroid_override
    get_current_driver
    if [ "${CONFDRIVER}" = "libmali" ]; then
      load_driver libmali
    fi
  fi
}


case "$1" in
  "--options")
    echo "panfrost libmali"
    ;;
  "--start")
    get_current_driver
    load_driver ${CONFDRIVER}
    ;;
  "--waydroid-ensure")
    waydroid_ensure_drm
    ;;
  "--waydroid-restore")
    waydroid_restore
    ;;
  "libmali")
    # Refuse to switch to libmali while Waydroid is running — it would
    # lose GPU acceleration (mali_kbase has no DRM render node).
    if is_waydroid_running; then
      echo "Cannot switch to libmali while Waydroid is running." >&2
      echo "Stop Waydroid first, then switch." >&2
      exit 2
    fi
    set_setting ${GPU_DRIVER_SETTING_KEY} $1
    @DTB_OVERLAY_UNLOAD@
    ;;
  "panfrost")
    set_setting ${GPU_DRIVER_SETTING_KEY} $1
    @DTB_OVERLAY_LOAD@
    ;;
  "")
    get_current_driver
    echo ${CONFDRIVER}
    ;;
  *)
    echo "Unexpected parameter $1" >&2
    echo "Usage:" >&2
    echo "  List available drivers:                $0 --options" >&2
    echo "  Load configured driver and set libs:   $0 --start" >&2
    echo "  Get current driver:                    $0" >&2
    echo "  Configure driver to load on next boot: $0 <panfrost|libmali>" >&2
    echo "  Ensure DRM for Waydroid:               $0 --waydroid-ensure" >&2
    echo "  Restore driver after Waydroid:          $0 --waydroid-restore" >&2
    exit 1
    ;;
esac
