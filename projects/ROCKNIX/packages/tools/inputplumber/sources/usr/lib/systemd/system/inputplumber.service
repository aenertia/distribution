[Unit]
Description=InputPlumber Service
After=bluetooth.service
Before=sway.service

[Service]
Type=dbus
BusName=org.shadowblip.InputPlumber
Environment=LOG_LEVEL=info
Environment=HIDE_DEVICES_FROM_ROOT=1
Environment=INSECURE_DISABLE_POLKIT=1
ExecStartPre=-/usr/bin/mkdir -p /storage/.config/inputplumber/profiles
ExecStartPre=-/usr/bin/mkdir -p /dev/inputplumber/sources
ExecStart=/usr/bin/inputplumber
ProtectSystem=full
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
