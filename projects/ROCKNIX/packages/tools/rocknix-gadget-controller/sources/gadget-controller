#
# USB HID bridge controller — manages evdev→HID forwarding for the composite
# gadget's HID function. The HID function is always present in the composite
# gadget created by usbgadget; this script just starts/stops the bridge.
#
# Usage:
#   gadget-controller start-bridge  — find gamepad and start forwarding
#   gadget-controller stop-bridge   — stop forwarding
#   gadget-controller status        — show bridge state
#
# Legacy (delegates to usbgadget):
#   gadget-controller enable        — usbgadget controller
#   gadget-controller disable       — usbgadget disabled

BRIDGE_PID_FILE="/run/rocknix/gadget-hid-bridge.pid"

log() {
  echo "gadget-controller: $*" >&2
  logger -t gadget-controller "$*" 2>/dev/null
}

# Find InputPlumber's virtual gamepad evdev node
find_gamepad_evdev() {
  local evdev
  for evdev in /sys/class/input/event*/device/name; do
    local name
    name=$(cat "${evdev}" 2>/dev/null)
    case "${name}" in
      *"InputPlumber"*|*"Xbox"*Gamepad*|*"Microsoft X-Box"*|*"Virtual Gamepad"*)
        local event_node
        event_node=$(echo "${evdev}" | grep -oP 'event\d+')
        if [ -c "/dev/input/${event_node}" ]; then
          echo "/dev/input/${event_node}"
          return 0
        fi
        ;;
    esac
  done

  # Fallback: find any gamepad-like device (has ABS + KEY caps)
  for evdev in /sys/class/input/event*/device/capabilities/abs; do
    local abs_caps
    abs_caps=$(cat "${evdev}" 2>/dev/null)
    [ "${abs_caps}" = "0" ] && continue

    local key_caps
    key_caps=$(cat "$(dirname "${evdev}")/capabilities/key" 2>/dev/null)
    [ -z "${key_caps}" ] || [ "${key_caps}" = "0" ] && continue

    local event_node
    event_node=$(echo "${evdev}" | grep -oP 'event\d+')
    if [ -c "/dev/input/${event_node}" ]; then
      echo "/dev/input/${event_node}"
      return 0
    fi
  done

  return 1
}

start_bridge() {
  mkdir -p /run/rocknix

  if [ ! -c /dev/hidg0 ]; then
    log "WARNING: /dev/hidg0 not available — is the composite gadget running?"
    log "Run 'usbgadget controller' to enable"
    return 1
  fi

  local evdev_path
  evdev_path=$(find_gamepad_evdev)
  if [ -z "${evdev_path}" ]; then
    log "WARNING: No gamepad evdev found, bridge not started"
    log "Ensure InputPlumber is running"
    return 1
  fi

  log "Starting HID bridge: ${evdev_path} -> /dev/hidg0"
  /usr/bin/gadget-hid-bridge "${evdev_path}" /dev/hidg0 &
  echo $! > "${BRIDGE_PID_FILE}"
}

stop_bridge() {
  if [ -f "${BRIDGE_PID_FILE}" ]; then
    local pid
    pid=$(cat "${BRIDGE_PID_FILE}")
    kill "${pid}" 2>/dev/null
    local i=0
    while [ ${i} -lt 10 ] && kill -0 "${pid}" 2>/dev/null; do
      sleep 0.1
      i=$((i + 1))
    done
    kill -9 "${pid}" 2>/dev/null
    rm -f "${BRIDGE_PID_FILE}"
  fi
  killall gadget-hid-bridge 2>/dev/null
}

show_status() {
  if [ -f "${BRIDGE_PID_FILE}" ] && kill -0 "$(cat "${BRIDGE_PID_FILE}")" 2>/dev/null; then
    echo "Status: active"
    echo "Bridge: running (PID $(cat "${BRIDGE_PID_FILE}"))"
  else
    echo "Status: inactive"
  fi
  [ -c /dev/hidg0 ] && echo "HID device: /dev/hidg0" || echo "HID device: not available"
}

case "$1" in
  start-bridge)
    start_bridge
    ;;
  stop-bridge)
    stop_bridge
    ;;
  status)
    show_status
    ;;
  # Legacy commands — delegate to usbgadget
  enable)
    [ -x /usr/bin/usbgadget ] && exec /usr/bin/usbgadget controller
    ;;
  disable)
    [ -x /usr/bin/usbgadget ] && exec /usr/bin/usbgadget disabled
    ;;
  *)
    echo "Usage: gadget-controller <start-bridge|stop-bridge|status>"
    exit 1
    ;;
esac
