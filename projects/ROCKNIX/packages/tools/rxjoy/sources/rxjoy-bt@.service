[Unit]
Description=rxjoy %i Bluetooth controller emulation
After=inputplumber.service bluetooth.service
Wants=inputplumber.service bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/rxjoy --profile %i --transport bluetooth --pair
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
