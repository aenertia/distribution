# Refactored as thin rxnm shim — all operations delegate to rxnm's native wifi module.
# Backward-compatible interface preserved for legacy scripts and sleep hooks.

. /etc/profile

WIFI_DEV="$(ls /sys/class/net 2>/dev/null | grep -m1 ^wlan)"
[ -z "$WIFI_DEV" ] && exit 0
[ ! -d "/sys/class/net/${WIFI_DEV}" ] && exit 0

SSID="${2:-$(get_setting wifi.ssid 2>/dev/null)}"
PSK="${3:-$(get_setting wifi.key 2>/dev/null)}"
COUNTRY="${4:-$(get_setting wifi.country 2>/dev/null | tr -d '[:space:]')}"

case "${1}" in
  enable)
    rfkill unblock wifi
    ;;
  disable)
    rfkill block wifi
    ;;
  connect)
    rfkill unblock wifi
    [ -n "$COUNTRY" ] && iw reg set "$COUNTRY" 2>/dev/null
    if [ -n "$SSID" ]; then
      rxnm wifi connect "$SSID" "$PSK" --format json >/dev/null 2>&1
    fi
    ;;
  disconnect)
    rxnm wifi disconnect --format json >/dev/null 2>&1
    ;;
  reconnect)
    rxnm wifi disconnect --format json >/dev/null 2>&1
    sleep 0.5
    if [ -n "$SSID" ]; then
      rxnm wifi connect "$SSID" "$PSK" --format json >/dev/null 2>&1
    fi
    ;;
  list)
    rxnm wifi scan --format simple 2>/dev/null
    ;;
  scanlist)
    rxnm wifi scan --format simple 2>/dev/null
    ;;
  scan)
    rxnm wifi scan --format json >/dev/null 2>&1
    ;;
  has_ap_mode)
    PHY=$(basename "$(readlink "/sys/class/net/${WIFI_DEV}/phy80211")" 2>/dev/null)
    [ -n "$PHY" ] && iwctl adapter "$PHY" show 2>/dev/null | grep -q 'SupportedModes.*ap' && exit 0
    exit 1
    ;;
  channels)
    iw list | awk '/[0-9] MHz \[/ && ! /disabled|radar|no IR/ { gsub(/^.*\[/,""); gsub(/\].*$/,""); print}'
    ;;
esac
