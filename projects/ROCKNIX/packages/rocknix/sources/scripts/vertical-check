#!/bin/sh

. /etc/profile
. /usr/lib/rocknix-display/display-core.sh

ARCADEROMS_XML="/usr/config/emulationstation/resources/arcaderoms.xml"

RUNEMU_LINE=$(ps aux | grep '[r]unemu.sh' | head -n 1)
CURRENT_CORE=$(echo "${RUNEMU_LINE}" | sed -n 's/.*--core=\([^ ]*\).*/\1/p')
ROM_PATH=$(echo "${RUNEMU_LINE}" | sed -n 's|.*runemu\.sh \([^ ]*\).*|\1|p')

if [ -z "${CURRENT_CORE}" ] || [ -z "${ROM_PATH}" ]; then
    exit 0
fi

ROM_NAME=$(basename "${ROM_PATH}" | sed 's/\.[^.]*$//')
IS_VERTICAL=false

case "${CURRENT_CORE}" in
    # Unconditionally vertical
    melonds*|desmume|vecx)
        IS_VERTICAL=true
        ;;
    # Might not be vertical
    mame*|fbneo|fbalpha*)
        if grep -q "id=\"${ROM_NAME}\"[^>]*vert=\"true\"" "${ARCADEROMS_XML}" 2>/dev/null; then
            IS_VERTICAL=true
        fi
        ;;
esac

case "${ROM_NAME}" in
    # Also check for some specific roms that aren't marked vert
    punchout*|spnchout*|pc_*|mp_*)
        IS_VERTICAL=true
        ;;
esac

if [ "${IS_VERTICAL}" = "true" ] && display_is_dual; then
    display_stack_vertical

    # Float RetroArch window to span both outputs using computed canvas geometry
    swaymsg '[title="RetroArch.*"]' floating enable, fullscreen disable, \
        resize set "$CANVAS_W" "$CANVAS_H", \
        move to output "$DISPLAY_TOP", \
        move absolute position "$VSTACK_PRI_X" 0 2>/dev/null

    # Map touch to bottom panel if touch is available
    if [ -n "$TOUCH_DEVICE" ]; then
        display_map_touch_to "$DISPLAY_BOTTOM"
    fi
fi
