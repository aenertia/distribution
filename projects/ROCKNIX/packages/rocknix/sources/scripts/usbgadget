#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2024-2026 ROCKNIX (https://github.com/ROCKNIX)
#
# Composite USB gadget: NCM network + MTP file transfer + ACM serial + HID gamepad
# All functions coexist in one gadget — no teardown needed to switch modes.
# Networking is handled by systemd-networkd via rxnm's 70-usb-gadget.network
# Recovery mode mass storage is handled separately in initramfs (busybox/scripts/init)

. /etc/os-release

SERIAL=$(cat /storage/.cache/systemd-machine-id 2>/dev/null || echo "0000000000000000")
CACHEDIR=/storage/.cache/usbgadget
GADGETCONF=${CACHEDIR}/usbgadget.conf
GADGET=/sys/kernel/config/usb_gadget/rocknix
BRIDGE_PID_FILE=/run/rocknix/gadget-hid-bridge.pid

devversion=0x$(echo $OS_VERSION | cut -b 3-6)

for mod in usb_f_ncm usb_f_fs usb_f_acm usb_f_hid; do
	modprobe -q ${mod} 2>/dev/null
done

mkdir -p ${CACHEDIR}
[ -r ${GADGETCONF} ] && . ${GADGETCONF}

UDC_NAME=$(ls -1 /sys/class/udc 2>/dev/null | head -n1)
[ -z "${UDC_NAME}" ] && exit 1

# Detect USB speed from hardware
detect_usb_speed() {
	local max_speed=$(cat /sys/class/udc/${UDC_NAME}/maximum_speed 2>/dev/null)
	case "${max_speed}" in
		super-speed-plus) echo "0x0320" ;;
		super-speed)      echo "0x0310" ;;
		*)                echo "0x0200" ;;
	esac
}

# RK3566 dwc3 quirk: soft disconnect/reconnect for ep0out failure
usb_trigger() {
	[ "${HW_DEVICE}" != "RK3566" ] && return
	grep -q 'control' /sys/kernel/debug/usb/${UDC_NAME}/ep0out/transfer_type 2>/dev/null && return

	local cmd=disconnect
	is_cable_connected && cmd=connect

	if [ "$1" = "async" ]; then
		echo ${cmd} > /sys/class/udc/${UDC_NAME}/soft_connect 2>/dev/null &
	else
		echo ${cmd} > /sys/class/udc/${UDC_NAME}/soft_connect 2>/dev/null
	fi
}

is_cable_connected() {
	local PHY_NAME=$(ls -d /sys/devices/platform/${UDC_NAME}/supplier:platform:*usb2phy 2>/dev/null | sed 's|^.*:platform:||')
	for cable in /sys/devices/platform/${PHY_NAME}/extcon/*/cable.*; do
		local cable_name="$(cat ${cable}/name 2>/dev/null)"
		case "${cable_name}" in
			SDP|CDP)
				grep -q 1 ${cable}/state 2>/dev/null && return 0
				;;
		esac
	done
	return 1
}

set_role() {
	for sw in $(ls -1 /sys/class/udc/${UDC_NAME}/device/usb_role/*/role 2>/dev/null); do
		timeout 2 sh -c "echo $1 > '$sw'" 2>/dev/null
	done
}

# Write HID report descriptor binary for a standard gamepad
# Gamepad + motion: 16 buttons, hat, 4 sticks, 2 triggers, 3 accel, 3 gyro = 21 byte report
# Must be a single write — configfs binary attributes don't support append
write_hid_report_desc() {
	printf '\x05\x01\x09\x05\xa1\x01\x05\x09\x19\x01\x29\x10\x15\x00\x25\x01\x95\x10\x75\x01\x81\x02\x05\x01\x09\x39\x15\x00\x25\x07\x35\x00\x46\x3b\x01\x65\x14\x75\x04\x95\x01\x81\x42\x75\x04\x95\x01\x81\x01\x05\x01\x09\x30\x09\x31\x09\x33\x09\x34\x15\x00\x26\xff\x00\x75\x08\x95\x04\x81\x02\x09\x32\x09\x35\x15\x00\x26\xff\x00\x75\x08\x95\x02\x81\x02\x05\x20\x09\x73\xa1\x00\x09\x53\x09\x54\x09\x55\x16\x00\x80\x26\xff\x7f\x75\x10\x95\x03\x81\x02\xc0\x05\x20\x09\x76\xa1\x00\x09\x57\x09\x58\x09\x59\x16\x00\x80\x26\xff\x7f\x75\x10\x95\x03\x81\x02\xc0\xc0' > "$1"
}

# Force teardown of any existing gadget (handles dirty state from crash)
# WARNING: On RK3566 DWC3, UDC unbind can hang with active USB cable.
# Only called from gadget_stop (explicit disable) and gadget_start (re-setup).
gadget_teardown() {
	[ ! -d ${GADGET} ] && return

	# Stop rxjoy and HID bridge if running
	rxjoy_stop
	bridge_stop

	# Kill all gadget consumers BEFORE UDC unbind
	killall -q umtprd 2>/dev/null
	local getty_pid=$(cat /var/run/gadget-getty.pid 2>/dev/null)
	[ -n "${getty_pid}" ] && kill ${getty_pid} 2>/dev/null
	rm -f /var/run/gadget-getty.pid

	# Wait for umtprd to exit (SIGKILL if needed)
	local i=0
	while [ ${i} -lt 10 ] && killall -0 umtprd 2>/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	killall -9 -q umtprd 2>/dev/null

	# Unmount functionfs (must happen after umtprd is dead)
	if [ -d /dev/ffs-umtp ]; then
		umount -l /dev/ffs-umtp 2>/dev/null
		rmdir /dev/ffs-umtp 2>/dev/null
	fi

	# Soft-disconnect from host before UDC unbind (clean host-side detach)
	# NOTE: do NOT "ip link set gadget down" — hangs DWC3 on RK3566
	echo disconnect > /sys/class/udc/${UDC_NAME}/soft_connect 2>/dev/null
	sleep 0.5

	# Unbind UDC (implicitly tears down NCM/ACM/HID functions)
	timeout 3 sh -c 'echo "" > '"${GADGET}"'/UDC' 2>/dev/null

	# Unlink functions from config
	rm -f ${GADGET}/os_desc/c.1
	rm -f ${GADGET}/configs/c.1/ncm.usb0
	rm -f ${GADGET}/configs/c.1/ffs.mtp
	rm -f ${GADGET}/configs/c.1/acm.usb0
	rm -f ${GADGET}/configs/c.1/hid.usb0

	# Remove config strings and config
	rmdir ${GADGET}/configs/c.1/strings/0x409 2>/dev/null
	rmdir ${GADGET}/configs/c.1 2>/dev/null

	# Remove functions
	rmdir ${GADGET}/functions/ncm.usb0 2>/dev/null
	rmdir ${GADGET}/functions/ffs.mtp 2>/dev/null
	rmdir ${GADGET}/functions/acm.usb0 2>/dev/null
	rmdir ${GADGET}/functions/hid.usb0 2>/dev/null

	# Remove gadget strings and root
	rmdir ${GADGET}/strings/0x409 2>/dev/null
	rmdir ${GADGET} 2>/dev/null
}

# Create composite gadget with NCM + MTP + ACM + HID
gadget_setup() {
	local usb_ver=$(detect_usb_speed)

	mkdir -p ${GADGET}
	echo "${usb_ver}" > ${GADGET}/bcdUSB
	echo "0xEF"       > ${GADGET}/bDeviceClass
	echo "0x02"       > ${GADGET}/bDeviceSubClass
	echo "0x01"       > ${GADGET}/bDeviceProtocol
	echo "0x1d6b"     > ${GADGET}/idVendor
	echo "0x0104"     > ${GADGET}/idProduct
	echo "${devversion}" > ${GADGET}/bcdDevice

	mkdir -p ${GADGET}/strings/0x409
	echo "${OS_NAME}"      > ${GADGET}/strings/0x409/manufacturer
	echo "${QUIRK_DEVICE}" > ${GADGET}/strings/0x409/product
	echo "${SERIAL}"       > ${GADGET}/strings/0x409/serialnumber

	# Single config with all functions
	mkdir -p ${GADGET}/configs/c.1/strings/0x409
	echo "0xC0" > ${GADGET}/configs/c.1/bmAttributes
	echo "0xfa" > ${GADGET}/configs/c.1/MaxPower
	echo "ROCKNIX Composite" > ${GADGET}/configs/c.1/strings/0x409/configuration

	# NCM network
	mkdir -p ${GADGET}/functions/ncm.usb0
	local smac=$(echo ${SERIAL} | cut -b 1-12)
	echo "82ba1c9278b1"            > ${GADGET}/functions/ncm.usb0/dev_addr
	echo "12$(echo ${smac} | cut -b 3-)" > ${GADGET}/functions/ncm.usb0/host_addr
	echo "WINNCM" > ${GADGET}/functions/ncm.usb0/os_desc/interface.ncm/compatible_id
	echo "1"      > ${GADGET}/os_desc/use
	echo "0xcd"   > ${GADGET}/os_desc/b_vendor_code
	echo "MSFT100" > ${GADGET}/os_desc/qw_sign

	# MTP file transfer (umtprd on functionfs)
	mkdir -p ${GADGET}/functions/ffs.mtp

	# ACM serial console
	mkdir -p ${GADGET}/functions/acm.usb0

	# HID gamepad (always present — avoids DWC3 hang from UDC rebind)
	modprobe -q usb_f_hid 2>/dev/null
	mkdir -p ${GADGET}/functions/hid.usb0
	echo "0" > ${GADGET}/functions/hid.usb0/protocol
	echo "0" > ${GADGET}/functions/hid.usb0/subclass
	echo "21" > ${GADGET}/functions/hid.usb0/report_length
	write_hid_report_desc ${GADGET}/functions/hid.usb0/report_desc

	# Link all functions to config
	ln -sf ${GADGET}/functions/ncm.usb0 ${GADGET}/configs/c.1/ncm.usb0
	ln -sf ${GADGET}/functions/ffs.mtp  ${GADGET}/configs/c.1/ffs.mtp
	ln -sf ${GADGET}/functions/acm.usb0 ${GADGET}/configs/c.1/acm.usb0
	ln -sf ${GADGET}/functions/hid.usb0 ${GADGET}/configs/c.1/hid.usb0
	ln -sf ${GADGET}/configs/c.1        ${GADGET}/os_desc/c.1
}

gadget_start() {
	# Exit if a downstream device is connected (RK3326 single port with WiFi)
	grep -q configured /sys/class/udc/${UDC_NAME}/device/usb1/1-0\:1.0/usb1-port1/state 2>/dev/null && exit 3

	# If gadget already exists and UDC is bound, nothing to do
	if [ -d ${GADGET} ] && [ -n "$(cat ${GADGET}/UDC 2>/dev/null)" ]; then
		return 0
	fi

	set_role device

	# Create composite gadget (NCM + MTP + ACM + HID)
	gadget_setup

	# Mount MTP functionfs and start umtprd
	mkdir -p /dev/ffs-umtp
	mount mtp -t functionfs /dev/ffs-umtp 2>/dev/null
	/usr/sbin/umtprd &
	sleep 1

	# Bind UDC
	echo "${UDC_NAME}" > ${GADGET}/UDC

	# RK3566 dwc3 quirk
	usb_trigger async

	# Start getty on serial console once /dev/ttyGS0 appears
	(
		_t=0
		while [ ! -c /dev/ttyGS0 ] && [ ${_t} -lt 50 ]; do
			sleep 0.1
			_t=$((_t + 1))
		done
		if [ -c /dev/ttyGS0 ]; then
			while true; do
				setsid getty -L 115200 /dev/ttyGS0 vt100
				sleep 1
			done
		fi
	) &
	echo $! > /var/run/gadget-getty.pid
}

gadget_stop() {
	gadget_teardown
	set_role host
	echo "USB_MODE=disabled" > ${GADGETCONF}
}

# Wait for HID device node (HID function is created in gadget_setup)
add_hid_function() {
	local w=0
	while [ ! -c /dev/hidg0 ] && [ ${w} -lt 30 ]; do
		sleep 0.1
		w=$((w + 1))
	done
}

# HID function stays in composite permanently (no-op)
remove_hid_function() {
	:
}

# HID bridge management — start/stop evdev→/dev/hidg0 forwarding
bridge_start() {
	bridge_stop
	mkdir -p /run/rocknix
	if [ -x /usr/bin/gadget-hid-bridge ] && [ -c /dev/hidg0 ]; then
		# Find gamepad evdev via gadget-controller helper
		if [ -x /usr/bin/gadget-controller ]; then
			/usr/bin/gadget-controller start-bridge &
			echo $! > ${BRIDGE_PID_FILE}
		fi
	fi
}

bridge_stop() {
	if [ -f "${BRIDGE_PID_FILE}" ]; then
		local pid=$(cat "${BRIDGE_PID_FILE}")
		kill "${pid}" 2>/dev/null
		local i=0
		while [ ${i} -lt 10 ] && kill -0 "${pid}" 2>/dev/null; do
			sleep 0.1
			i=$((i + 1))
		done
		kill -9 "${pid}" 2>/dev/null
		rm -f "${BRIDGE_PID_FILE}"
	fi
	# Also kill any stray bridge processes
	killall gadget-hid-bridge 2>/dev/null
}

# rxjoy management — start/stop multi-profile controller emulation
# RK3566 DWC3 hangs on UDC unbind with active cable — cannot teardown composite.
# Instead: add HID function to composite gadget, rxjoy uses /dev/hidg0.
# For raw_gadget profiles (xinput, xboxog, gc, instruments), rxjoy uses
# /dev/raw-gadget directly (separate from composite, no UDC conflict).
rxjoy_start() {
	rxjoy_stop
	local profile=$(get_setting system.controller_output.profile 2>/dev/null)
	[ -z "${profile}" ] && profile="dinput"
	local audio=$(get_setting system.controller_output.audio 2>/dev/null)

	# Ensure composite gadget is up and HID function is added
	if [ ! -d ${GADGET} ] || [ -z "$(cat ${GADGET}/UDC 2>/dev/null)" ]; then
		gadget_start
	fi
	add_hid_function

	if [ "${audio}" = "usb" ] || [ "${audio}" = "bluetooth" ]; then
		systemd-run --unit="rxjoy-active" --property=After=inputplumber.service \
			--property=TimeoutStopSec=5 /usr/bin/rxjoy --profile "${profile}" --audio
	else
		systemctl start "rxjoy@${profile}"
	fi
}

rxjoy_stop() {
	# Stop all rxjoy instances (template units + transient audio unit)
	systemctl stop rxjoy-active 2>/dev/null
	for unit in $(systemctl list-units --plain --no-legend 'rxjoy@*' 2>/dev/null | awk '{print $1}'); do
		systemctl stop "${unit}" 2>/dev/null
	done
}

case "$1" in
	# ES integration API
	"--options")
		echo "disabled network file_transfer serial controller"
		;;
	"--start")
		if [ "${USB_MODE}" != "disabled" ] && [ -n "${USB_MODE}" ]; then
			gadget_start
			if [ "${USB_MODE}" = "controller" ]; then
				add_hid_function
				if [ -x /usr/bin/rxjoy ]; then
					rxjoy_start
				else
					bridge_start
				fi
			fi
		fi
		;;
	"")
		if [ -d ${GADGET} ] && [ "$(cat ${GADGET}/UDC 2>/dev/null)" != "" ]; then
			echo "${USB_MODE:-network}"
		else
			echo "disabled"
		fi
		;;
	"network"|"file_transfer"|"serial"|"enabled")
		rxjoy_stop
		bridge_stop
		remove_hid_function
		# Restore composite gadget (rxjoy may have torn it down)
		gadget_start
		echo "USB_MODE=$1" > ${GADGETCONF}
		;;
	"controller")
		if [ ! -d ${GADGET} ] || [ -z "$(cat ${GADGET}/UDC 2>/dev/null)" ]; then
			gadget_start
		fi
		add_hid_function
		if [ -x /usr/bin/rxjoy ]; then
			rxjoy_start
		else
			bridge_start
		fi
		echo "USB_MODE=controller" > ${GADGETCONF}
		;;
	"disabled")
		# Stop controller output but keep composite gadget running
		# (DWC3 UDC unbind hangs on RK3566 — full teardown only at shutdown)
		rxjoy_stop
		bridge_stop
		echo "USB_MODE=disabled" > ${GADGETCONF}
		;;
	"address")
		ip -4 addr show gadget 2>/dev/null | grep -oP 'inet \K[0-9.]+' || echo "not configured"
		;;
	"trigger")
		usb_trigger
		;;

	# Legacy API compatibility
	"start")
		gadget_start
		;;
	"stop")
		gadget_stop
		;;
	"restart")
		gadget_stop
		gadget_start
		;;

	*)
		echo "Usage:"
		echo "  $0 --options        List available modes"
		echo "  $0 --start          Restore previously chosen mode"
		echo "  $0                  Show current mode"
		echo "  $0 <mode>           Switch mode (disabled|network|file_transfer|serial|controller)"
		echo "  $0 address          Show network gadget IP address"
		echo "  $0 trigger          Trigger soft reconnect (RK3566 quirk)"
		;;
esac
