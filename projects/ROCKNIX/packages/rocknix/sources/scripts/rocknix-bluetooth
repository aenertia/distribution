# Thin compatibility wrapper - delegates all BT operations to rxnm 1.2+

case "${1}" in
  enable)         rxnm bluetooth enable --format json 2>/dev/null ;;
  disable)        rxnm bluetooth disable --format json 2>/dev/null ;;
  list)           rxnm bluetooth list --format json 2>/dev/null ;;
  trust)
    if [ "${2}" = "input" ]; then
      rxnm bluetooth auto-pair --filter input --timeout 30 --format json 2>/dev/null
    else
      rxnm bluetooth pair "${2}" --format json 2>/dev/null
    fi
    ;;
  connect)        rxnm bluetooth connect "${2}" --format json 2>/dev/null ;;
  disconnect)     rxnm bluetooth disconnect "${2}" --format json 2>/dev/null ;;
  remove)         rxnm bluetooth unpair "${2}" --format json 2>/dev/null ;;
  live_devices|start_live_devices)
                  rxnm bluetooth live-scan --timeout 60 --format json 2>/dev/null ;;
  stop_live_devices)
                  pkill -f 'rxnm bluetooth live-scan' 2>/dev/null ;;
  save)           rxnm bluetooth save --format json 2>/dev/null ;;
  restore)        rxnm bluetooth restore --format json 2>/dev/null ;;
esac
