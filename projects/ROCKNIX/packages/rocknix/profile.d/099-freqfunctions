. /etc/os-release

# Need GPU_FREQ var
GOVERNORS="/storage/.config/profile.d/010-governors"
[[ -f ${GOVERNORS} ]] && source ${GOVERNORS}

get_threads() {
  for THREAD in $(seq 1 1 $(find /sys/devices/system/cpu -name online | wc -l)) all default; do
    echo ${THREAD}
  done
}

set_online_threads() {
  AVAILABLE_THREADS=$(($(find /sys/devices/system/cpu -name online | wc -l) - 1))
  MODE=${2}
  if [ -z "${MODE}" ]; then
    MODE=0
  fi
  case ${1} in
    default)
      return
      ;;
    all)
      THREADS=0
      MODE="1"
      ;;
    0)
      THREADS=1
      ;;
    *)
      THREADS=${1}
      ;;
  esac

  for thread in $(seq 0 1 ${THREADS}); do
    echo 1  | tee /sys/devices/system/cpu/cpu${thread}/online >/dev/null 2>&1
  done

  for thread in $(seq ${THREADS} 1 ${AVAILABLE_THREADS}); do
    echo ${MODE} | tee /sys/devices/system/cpu/cpu${thread}/online >/dev/null 2>&1
  done
}

set_cpu_gov() {
  for POLICY in $(ls /sys/devices/system/cpu/cpufreq 2>/dev/null | grep policy[0-9]); do
    if [ -e "/sys/devices/system/cpu/cpufreq/${POLICY}/scaling_governor" ]; then
      echo $1 >/sys/devices/system/cpu/cpufreq/${POLICY}/scaling_governor 2>/dev/null
    fi
  done
}

set_dmc_gov() {
  if [ -e "${DMC_FREQ}/governor" ]; then
    for governor in $1 dmc_$1 simple_$1; do
      echo ${governor} >${DMC_FREQ}/governor 2>/dev/null
      if [ "$?" = 0 ]; then
        return
      fi
   done
  fi
}

set_gpu_gov() {
  if [ -e "${GPU_FREQ}/governor" ]; then
    for governor in $1 dmc_$1 simple_$1; do
      echo ${governor} >${GPU_FREQ}/governor 2>/dev/null
      if [ "$?" = 0 ]; then
        return
      fi
   done
  fi
}

onlinethreads() {
  set_online_threads ${1} ${2}
}

### Uclamp (utilization clamping) — frequency hints for schedutil + core placement for EAS
has_uclamp() {
  [ -f /proc/sys/kernel/sched_util_clamp_min ]
}

set_system_uclamp() {
  has_uclamp || return 0
  echo "${1:-0}" > /proc/sys/kernel/sched_util_clamp_min 2>/dev/null
  echo "${2:-1024}" > /proc/sys/kernel/sched_util_clamp_max 2>/dev/null
}

set_rt_uclamp() {
  has_uclamp || return 0
  echo "${1:-1024}" > /proc/sys/kernel/sched_util_clamp_min_rt_default 2>/dev/null
}

set_slice_uclamp() {
  local slice="$1" min="$2" max="$3"
  local path=""
  for base in /sys/fs/cgroup /sys/fs/cgroup/system.slice /sys/fs/cgroup/rocknix.slice; do
    [ -d "${base}/${slice}" ] && path="${base}/${slice}" && break
  done
  [ -n "$path" ] && [ -f "$path/cpu.uclamp.min" ] || return 0
  echo "${min}" > "$path/cpu.uclamp.min" 2>/dev/null
  echo "${max}" > "$path/cpu.uclamp.max" 2>/dev/null
}

# Set cgroup v2 memory ceiling on a slice.
# memory.max = hard limit (OOM-kill the process, not the system)
# memory.high = 90% of max (throttle allocations, give GC time to collect)
set_slice_memory_limit() {
  local slice="$1" max_bytes="$2"
  local path=""
  for base in /sys/fs/cgroup /sys/fs/cgroup/system.slice /sys/fs/cgroup/rocknix.slice; do
    [ -d "${base}/${slice}" ] && path="${base}/${slice}" && break
  done
  [ -n "$path" ] && [ -f "$path/memory.max" ] || return 0
  echo "${max_bytes}" > "$path/memory.max" 2>/dev/null
  echo "$(( max_bytes * 9 / 10 ))" > "$path/memory.high" 2>/dev/null
}

# Map emulated system to demand tier. Platform 010-governors defines
# UCLAMP_LIGHT/MEDIUM/HEAVY/VERY_HEAVY to scale these per SoC capability.
get_system_uclamp_tier() {
  case "$1" in
    gb|gbc|gba|nes|famicom|snes|sfc|sms|gamegear|sg-1000|genesis|megadrive|mastersystem|segacd|megacd|sega32x|atarilynx|atari2600|atari5200|atari7800|atarist|colecovision|msx|msx2|vectrex|wonderswan|wonderswancolor|pcengine|pcenginecd|tg16|tg16cd|supergrafx|supervision|channelf|odyssey2|intellivision|amstradcpc|zxspectrum|amiga|c64|vic20|pet|scummvm|pico-8|tic-80|easyrpg|openbor|doom|quake|wolfenstein)
      echo "light" ;;
    psx|n64|nds|dreamcast|saturn|segast-v|arcade|mame|fbneo|fba|neogeo|neogeocd|naomi|atomiswave|jaguar|3do|virtualboy|pcfx|cdi)
      echo "medium" ;;
    psp|gamecube|gc|wii|ps2|xbox|n3ds)
      echo "heavy" ;;
    3ds|ps3|wiiu|switch|vita)
      echo "very_heavy" ;;
    *)
      echo "medium" ;;
  esac
}

# Resolve uclamp_min from tier using platform-defined scale values.
resolve_uclamp_tier() {
  case "$1" in
    light)      echo "${UCLAMP_LIGHT:-0}" ;;
    medium)     echo "${UCLAMP_MEDIUM:-256}" ;;
    heavy)      echo "${UCLAMP_HEAVY:-512}" ;;
    very_heavy) echo "${UCLAMP_VERY_HEAVY:-768}" ;;
    *)          echo "${UCLAMP_EMU_MIN:-384}" ;;
  esac
}

performance() {
  set_cpu_gov performance
  set_dmc_gov performance
}

ondemand() {
  set_cpu_gov ondemand
  set_dmc_gov ondemand
}

schedutil() {
  set_cpu_gov schedutil
  set_dmc_gov ondemand
  set_rt_uclamp 512
}

powersave() {
  set_cpu_gov powersave
  set_dmc_gov powersave
  set_system_uclamp 0 512
}

get_gpu_performance_level() {
  get_setting system.gpuperf
}

gpu_performance_level() {
  case ${1} in
    auto|default)
      set_gpu_gov ondemand
      ;;
    *)
      set_gpu_gov ${1}
      ;;
  esac
}

get_available_gpu_governors() {
  echo "default"; tr " " "\n" < $GPU_FREQ/available_governors | grep \[a-z\]
}
