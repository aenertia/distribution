[Unit]
Description=ROCKNIX NFS Game Share Mount
After=network-online.target rocknix-automount.service
Wants=network-online.target
ConditionPathExists=/storage/.nfs-mount

[Service]
Type=oneshot
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStart=/usr/bin/nfs-game-mount
RemainAfterExit=yes
TimeoutStartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfs-game-mount

[Install]
WantedBy=rocknix.target
