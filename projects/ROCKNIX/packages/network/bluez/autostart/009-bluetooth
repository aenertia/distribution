#!/bin/bash

# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

(
  BT_MODE=$(get_setting controllers.bluetooth.enabled)
  case "$BT_MODE" in
    controller)
      # BT Controller Output mode — start rxjoy-bt with configured profile
      PROFILE=$(get_setting system.controller_output.profile)
      [ -z "$PROFILE" ] && PROFILE="dinput"
      tocon "Starting BT controller output (${PROFILE})..."
      systemctl start "rxjoy-bt@${PROFILE}" &
      ;;
    1)
      # Standard Bluetooth — BlueZ for controllers, audio, PAN
      tocon "Starting bluetooth..."
      nohup /usr/bin/rocknix-bluetooth enable &
      ;;
  esac
) &
