        echo "  set-country             Set WiFi regulatory domain"
        echo "      --code <ISO 3166-1 alpha-2 code> (e.g., US, JP, DE)"
        echo "  set-link                Toggle IPv4/IPv6 link modes"
        echo "      --interface <iface> [--ipv4 off] [--ipv6 off]"
        echo "  set-global-dns          Set global systemd-resolved DNS overrides"
        echo "      --dns <ip,ip> [--domains <dom,dom>]"
        echo "  reset                   Reset/Cycle an interface"
        echo "      --interface <iface>"
        echo ""
        echo "PROFILE MANAGEMENT"
        echo "  profile save            Save current interface config as a profile"
