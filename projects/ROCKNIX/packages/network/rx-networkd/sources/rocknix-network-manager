# ROCKNIX Network Manager (Standalone)
# A generic systemd-networkd/iwd CLI wrapper.
# Refined for performance on low-power ARM targets (RK3326/RK3566).
# Supports legacy iptables (priority) and native nftables for NAT/Masquerading.

# Ensure no ANSI color codes in output from tools like iwctl
export TERM=dumb

# --- 0. LOCKING ---
: "${RUN_DIR:=/run/rocknix}"
mkdir -p "$RUN_DIR"
LOCKFILE="${RUN_DIR}/network.lock"
exec 200>"$LOCKFILE"
if ! flock -n 200; then
    echo "ERROR: Another instance of rocknix-network-manager is running." >&2
    exit 1
fi

# --- 1. CONFIGURATION & PATHS ---

: "${CONF_DIR:=/storage/.config}"
: "${STATE_DIR:=/var/lib}"

# Timeouts & Limits
CURL_TIMEOUT=2
SCAN_TIMEOUT=3
SCAN_POLL_MS=100  # Poll interval in milliseconds (0.1s)
WIFI_CHANNEL_MAX=177

ETC_NET_DIR="/etc/systemd/network"
STORAGE_NET_DIR="${CONF_DIR}/network"
STORAGE_PROFILES_DIR="${STORAGE_NET_DIR}/profiles"
STORAGE_WIFI_DIR="${STORAGE_NET_DIR}/wifi"
STORAGE_RESOLVED_DIR="${CONF_DIR}/resolved.conf.d"
STORAGE_RESOLVED_FILE="${STORAGE_RESOLVED_DIR}/global-dns.conf"
STORAGE_COUNTRY_FILE="${STORAGE_WIFI_DIR}/country"
STORAGE_PROXY_GLOBAL="${CONF_DIR}/proxy.conf"

TEMPLATE_NET_DIR="/usr/lib/rocknix/network"

STORAGE_HOST_NET_FILE="${STORAGE_NET_DIR}/70-wifi-host.network"
STORAGE_PAN_NET_FILE="${STORAGE_NET_DIR}/70-bluetooth-pan.network"
STORAGE_BT_PIN_FILE="${STORAGE_NET_DIR}/bluetooth.pin"

# Default Addressing Constants (Uncommon RFC1918 & "Arcade" ULA)
DEFAULT_GW_V4="192.168.212.1/24"
DEFAULT_GW_V6="fd00:a7ca:de00::1/64"

# --- 2. CLEANUP TRAP ---
cleanup() {
    rm -f "${STORAGE_NET_DIR}"/*.XXXXXX 2>/dev/null
}
trap cleanup EXIT

# --- 3. VALIDATION & HELPER FUNCTIONS ---

# Optimization: Direct file append for logging to avoid 'logger' overhead in tight loops if needed.
# For now, we keep logger but ensure it's not called in hot paths.
log_info() {
    local msg="$1"
    if [ -t 1 ]; then echo "INFO: $msg" >&2; fi
    logger -t rocknix-network "$msg"
}

log_error() {
    local msg="$1"
    if [ -t 1 ]; then echo "ERROR: $msg" >&2; fi
    logger -t rocknix-network "ERROR [${FUNCNAME[1]:-main}]: $msg"
}

sanitize_ssid() {
    local ssid="$1"
    if [ ${#ssid} -gt 32 ]; then
        log_error "SSID too long (max 32 bytes)"
        return 1
    fi
    local safe="${ssid//[^a-zA-Z0-9_-]/_}"
    [ -z "$safe" ] && safe="_unnamed_"
    echo "$safe"
}

validate_passphrase() {
    local pass="$1"
    local len=${#pass}
    if [ "$len" -lt 8 ] || [ "$len" -gt 63 ]; then return 1; fi
    return 0
}

validate_bluetooth_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9\ _-]+$ ]]; then return 1; fi
    if [ ${#name} -gt 248 ]; then return 1; fi
    return 0
}

validate_channel() {
    local ch="$1"
    if [[ ! "$ch" =~ ^[0-9]+$ ]]; then return 1; fi
    if [ "$ch" -lt 1 ] || [ "$ch" -gt "$WIFI_CHANNEL_MAX" ]; then return 1; fi
    return 0
}

validate_ip() {
    local ip="$1"
    local addr="${ip%/*}"
    local cidr="${ip#*/}"
    
    if [[ ! "$addr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then return 1; fi
    
    local IFS='.'
    read -r -a octets <<< "$addr"
    for octet in "${octets[@]}"; do
        if [[ ! "$octet" =~ ^[0-9]+$ ]]; then return 1; fi
        local num=$((10#$octet))
        if [ "$num" -lt 0 ] || [ "$num" -gt 255 ]; then return 1; fi
    done
    
    if [[ "$ip" == *"/"* ]]; then
        if [[ ! "$cidr" =~ ^[0-9]+$ ]] || [ "$cidr" -lt 0 ] || [ "$cidr" -gt 32 ]; then return 1; fi
    fi
    return 0
}

validate_routes() {
    local routes="$1"
    IFS=',' read -ra RTS <<< "$routes"
    for r in "${RTS[@]}"; do
        local dest="${r%%:*}"
        local rgw=""
        if [[ "$r" == *":"* ]]; then
            rgw="${r#*:}"
        fi
        
        # Validate Destination (CIDR)
        if ! validate_ip "$dest"; then return 1; fi
        
        # Validate Gateway if present
        if [ -n "$rgw" ]; then
            if ! validate_ip "$rgw"; then return 1; fi
        fi
    done
    return 0
}

validate_dns() {
    local dns_list="$1"
    IFS=',' read -ra SERVERS <<< "$dns_list"
    for server in "${SERVERS[@]}"; do
        if validate_ip "$server"; then continue; fi
        # IPv6 Check (Robust Regex)
        if [[ "$server" =~ ^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$ ]]; then
            continue
        fi
        return 1
    done
    return 0
}

validate_proxy_url() {
    local url="$1"
    if [[ "$url" =~ ^(http|https|socks4|socks5)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$ ]]; then return 0; fi
    if [[ "$url" =~ ^([0-9.]+):([0-9]+)$ ]]; then
        local ip="${BASH_REMATCH[1]}"
        local port="${BASH_REMATCH[2]}"
        if validate_ip "$ip"; then
             if [ "$port" -le 65535 ]; then return 0; fi
        fi
    fi
    return 1
}

validate_country() {
    local code="$1"
    if [[ ! "$code" =~ ^[A-Z]{2}$ ]]; then return 1; fi
    return 0
}

get_proxy_json() {
    local file="$1"
    if [ -f "$file" ]; then
        local http=$(grep -E "^(export )?http_proxy=" "$file" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")
        local https=$(grep -E "^(export )?https_proxy=" "$file" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")
        local noproxy=$(grep -E "^(export )?no_proxy=" "$file" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")

        [ -n "$http" ] && ! validate_proxy_url "$http" && http=""
        [ -n "$https" ] && ! validate_proxy_url "$https" && https=""

        jq -n --arg h "$http" --arg s "$https" --arg n "$noproxy" \
            '{http: (if $h!="" then $h else null end), https: (if $s!="" then $s else null end), noproxy: (if $n!="" then $n else null end)}'
    else
        echo "null"
    fi
}

# Generic Client/Station Config Builder (WAN/Upstream)
build_network_config() {
    local match_iface="$1"
    local match_ssid="$2"
    local dhcp="${3:-yes}"
    local desc="$4"
    local addresses="$5"
    local gateway="$6"
    local dns_servers="$7"
    local bridge="$8"
    local vlan="$9"
    local domains="${10}"
    local mac_policy="${11}"
    local routes="${12}"

    local config="[Match]\nName=${match_iface}\n"
    [ -n "$match_ssid" ] && config+="SSID=${match_ssid}\n"
    
    # Link Section for MAC Policy
    if [ -n "$mac_policy" ]; then
        config+="\n[Link]\nMACAddressPolicy=${mac_policy}\n"
    fi
    
    config+="\n[Network]\n"
    [ -n "$desc" ] && config+="Description=${desc}\n"
    [ -n "$dhcp" ] && config+="DHCP=${dhcp}\n"
    [ -n "$bridge" ] && config+="Bridge=${bridge}\n"
    [ -n "$vlan" ] && config+="VLAN=${vlan}\n"
    
    # Enable Masquerade on Client interfaces.
    # Note: We rely on systemd-networkd for persistence, but we may augment
    # with manual iptables calls in action_host/share to ensure support on legacy systems.
    config+="LinkLocalAddressing=yes\nIPv6AcceptRA=yes\nIPMasquerade=yes\n"

    if [ -n "$addresses" ]; then
        IFS=',' read -ra ADDRS <<< "$addresses"
        for addr in "${ADDRS[@]}"; do config+="Address=${addr}\n"; done
    fi
    
    if [ -n "$gateway" ]; then
        config+="Gateway=${gateway}\n"
    fi

    if [ -n "$dns_servers" ]; then
        IFS=',' read -ra DNS <<< "$dns_servers"
        for d in "${DNS[@]}"; do config+="DNS=${d}\n"; done
    fi
    
    if [ -n "$domains" ]; then
        IFS=',' read -ra DOMS <<< "$domains"
        for d in "${DOMS[@]}"; do config+="Domains=${d}\n"; done
    fi
    
    if [ -n "$routes" ]; then
        IFS=',' read -ra RTS <<< "$routes"
        for r in "${RTS[@]}"; do
            if [[ "$r" == *":"* ]]; then
                local dest="${r%%:*}"
                local rgw="${r#*:}"
                config+="\n[Route]\nDestination=${dest}\nGateway=${rgw}\n"
            else
                config+="\n[Route]\nDestination=${r}\n"
            fi
        done
    fi

    printf "%b" "$config"
}

# Gateway/Host/Sharing Config Builder (LAN/Downstream)
build_gateway_config() {
    local iface="$1"
    local ip="$2"
    local share="$3"
    local desc="$4"
    
    # 1. Determine IP Strategy
    # If no IP is provided, select based on Mode (Share vs Local) and Interface Type
    if [ -z "$ip" ]; then
        if [ "$share" == "true" ]; then
             # Gateway Mode: Use uncommon RFC1918
             ip="$DEFAULT_GW_V4"
        else
             # Local Mode (No Share): Use IANA Link Local
             if [[ "$iface" == usb* ]] || [[ "$iface" == rndis* ]]; then
                 # USB Gadget: Device = .2, Host will likely grab .1 (or be assigned)
                 ip="169.254.0.2/24"
             else
                 # Wireless/PAN/Ethernet: Larger range, .1 as device
                 ip="169.254.1.1/16" 
             fi
        fi
    fi

    local config="[Match]\nName=${iface}\n\n[Network]\nDescription=${desc}\n"
    
    # Host Mode Addressing
    if [ -n "$ip" ]; then
        config+="Address=${ip}\n"
    fi
    
    # NAT & Sharing Logic
    if [ "$share" == "true" ]; then
        # --- SHARING ENABLED (Gateway/Router) ---
        
        # Enable Forwarding on the LAN side so packets arriving here are passed to the WAN interface.
        config+="IPForwarding=yes\n"
        
        # Enable IPv6 ULA (Arcade Suffix)
        config+="Address=${DEFAULT_GW_V6}\n"
        
        # Override default LinkLocal logic for gateways to avoid conflict/delays
        # We prefer the Static IP + ULA
        config+="LinkLocalAddressing=no\n"
        
        # DHCPServer Configuration
        # IPv6SendRA=yes ensures the ULA prefix is advertised to clients.
        config+="DHCPServer=yes\nIPv6SendRA=yes\n\n[DHCPServer]\nPoolOffset=100\nEmitDNS=yes\n"
        config+="[IPv6SendRA]\nManaged=no\nOtherConfig=no\n"
        
    else
        # --- SHARING DISABLED (Local/Link-Local) ---
        
        # We enforce static Link-Local IP defined above, so disable auto-LL to avoid dual IPs
        config+="LinkLocalAddressing=no\nIPv6AcceptRA=no\n"
        
        # Enable DHCP Server to serve the Link-Local subnet
        # This allows simple P2P without manual IP config on the client side
        config+="DHCPServer=yes\n\n[DHCPServer]\n"
        config+="EmitDNS=yes\n"     # Advertise self for local resolution
        config+="EmitRouter=no\n"   # CRITICAL: Do NOT advertise as default gateway (Keep client internet on other iface)
        # Note: systemd-networkd calculates the pool based on the Address automatically.
    fi
    
    printf "%b" "$config"
}

# --- 4. FIREWALL & NAT MANAGEMENT ---

# Detect best available firewall tool, prioritizing legacy iptables for low-end targets
detect_firewall_tool() {
    if command -v iptables >/dev/null; then
        echo "iptables"
    elif command -v nft >/dev/null; then
        echo "nft"
    else
        echo "none"
    fi
}

enable_nat_masquerade() {
    local lan_iface="$1"
    if [ -z "$lan_iface" ]; then
        log_error "NAT enable failed: No LAN interface specified"
        return 1
    fi

    local fw_tool
    fw_tool=$(detect_firewall_tool)
    
    # Find upstream (WAN) interface
    local wan_iface
    # Try IPv4 default route
    wan_iface=$(ip -4 route show default 2>/dev/null | awk '/default/ {print $5}' | head -n1)
    
    # Fallback to IPv6 default route if no IPv4 default (e.g. IPv6-only or dual stack preference)
    if [ -z "$wan_iface" ]; then
        wan_iface=$(ip -6 route show default 2>/dev/null | awk '/default/ {print $5}' | head -n1)
    fi

    if [ -z "$wan_iface" ]; then
        log_info "No default route found. Skipping NAT masquerade enable."
        return 0
    fi
    
    # Prevent NAT loops if LAN == WAN (rare, but possible with certain bridge setups)
    if [ "$lan_iface" == "$wan_iface" ]; then
        log_info "LAN interface equals WAN interface. Skipping NAT."
        return 0
    fi

    log_info "Enabling NAT: LAN($lan_iface) -> WAN($wan_iface) using $fw_tool"

    if [ "$fw_tool" == "iptables" ]; then
        # --- IPv4 ---
        # 1. MASQUERADE outbound traffic on WAN
        if ! iptables -t nat -C POSTROUTING -o "$wan_iface" -m comment --comment "rocknix" -j MASQUERADE 2>/dev/null; then
            iptables -t nat -A POSTROUTING -o "$wan_iface" -m comment --comment "rocknix" -j MASQUERADE
        fi
        
        # 2. Forwarding: Allow LAN -> WAN
        if ! iptables -C FORWARD -i "$lan_iface" -o "$wan_iface" -m comment --comment "rocknix" -j ACCEPT 2>/dev/null; then
            iptables -A FORWARD -i "$lan_iface" -o "$wan_iface" -m comment --comment "rocknix" -j ACCEPT
        fi
        
        # 3. Forwarding: Allow WAN -> LAN (Established/Related)
        if ! iptables -C FORWARD -i "$wan_iface" -o "$lan_iface" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "rocknix" -j ACCEPT 2>/dev/null; then
            iptables -A FORWARD -i "$wan_iface" -o "$lan_iface" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "rocknix" -j ACCEPT
        fi
        
        # --- IPv6 (NAT66 for ULA) ---
        if command -v ip6tables >/dev/null; then
            # Verify kernel support for NAT66 (ip6table_nat module presence via cap check)
            if ip6tables -t nat -L >/dev/null 2>&1; then
                if ! ip6tables -t nat -C POSTROUTING -o "$wan_iface" -m comment --comment "rocknix" -j MASQUERADE 2>/dev/null; then
                    ip6tables -t nat -A POSTROUTING -o "$wan_iface" -m comment --comment "rocknix" -j MASQUERADE
                fi
                if ! ip6tables -C FORWARD -i "$lan_iface" -o "$wan_iface" -m comment --comment "rocknix" -j ACCEPT 2>/dev/null; then
                    ip6tables -A FORWARD -i "$lan_iface" -o "$wan_iface" -m comment --comment "rocknix" -j ACCEPT
                fi
                if ! ip6tables -C FORWARD -i "$wan_iface" -o "$lan_iface" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "rocknix" -j ACCEPT 2>/dev/null; then
                    ip6tables -A FORWARD -i "$wan_iface" -o "$lan_iface" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "rocknix" -j ACCEPT
                fi
            fi
        fi
        
    elif [ "$fw_tool" == "nft" ]; then
        # Native nftables support
        # We assume separate tables for clean removal later
        
        # --- IPv4 ---
        nft add table ip rocknix_nat 2>/dev/null
        # NAT Chain
        nft add chain ip rocknix_nat postrouting "{ type nat hook postrouting priority 100 ; }" 2>/dev/null
        nft add rule ip rocknix_nat postrouting oifname "$wan_iface" masquerade
        
        # Filter/Forward Chain
        nft add table ip rocknix_filter 2>/dev/null
        nft add chain ip rocknix_filter forward "{ type filter hook forward priority 0 ; }" 2>/dev/null
        nft add rule ip rocknix_filter forward iifname "$lan_iface" oifname "$wan_iface" accept
        nft add rule ip rocknix_filter forward iifname "$wan_iface" oifname "$lan_iface" ct state established,related accept
        
        # --- IPv6 ---
        nft add table ip6 rocknix_nat6 2>/dev/null
        # NAT Chain
        nft add chain ip6 rocknix_nat6 postrouting "{ type nat hook postrouting priority 100 ; }" 2>/dev/null
        nft add rule ip6 rocknix_nat6 postrouting oifname "$wan_iface" masquerade
        
        # Filter/Forward Chain
        nft add table ip6 rocknix_filter6 2>/dev/null
        nft add chain ip6 rocknix_filter6 forward "{ type filter hook forward priority 0 ; }" 2>/dev/null
        nft add rule ip6 rocknix_filter6 forward iifname "$lan_iface" oifname "$wan_iface" accept
        nft add rule ip6 rocknix_filter6 forward iifname "$wan_iface" oifname "$lan_iface" ct state established,related accept
    fi
}

disable_nat_masquerade() {
    local fw_tool
    fw_tool=$(detect_firewall_tool)
    
    if [ "$fw_tool" == "iptables" ]; then
        # Safe Removal: Only remove rules tagged with "rocknix"
        # We iterate because multiple rules might exist (v4, forward, nat, etc)
        
        # 1. Clean IPv4 NAT
        iptables-save -t nat | grep "comment rocknix" | sed 's/^-A/-D/' | while read -r rule; do 
            iptables -t nat $rule 2>/dev/null
        done
        
        # 2. Clean IPv4 Filter (Forward)
        iptables-save -t filter | grep "comment rocknix" | sed 's/^-A/-D/' | while read -r rule; do 
            iptables -t filter $rule 2>/dev/null
        done
        
        if command -v ip6tables >/dev/null; then
             # 3. Clean IPv6 NAT
             if ip6tables -t nat -L >/dev/null 2>&1; then
                 ip6tables-save -t nat | grep "comment rocknix" | sed 's/^-A/-D/' | while read -r rule; do 
                     ip6tables -t nat $rule 2>/dev/null
                 done
             fi
             # 4. Clean IPv6 Filter
             ip6tables-save -t filter | grep "comment rocknix" | sed 's/^-A/-D/' | while read -r rule; do 
                 ip6tables -t filter $rule 2>/dev/null
             done
        fi
        
    elif [ "$fw_tool" == "nft" ]; then
        # Remove our specific tables
        nft delete table ip rocknix_nat 2>/dev/null
        nft delete table ip rocknix_filter 2>/dev/null
        nft delete table ip6 rocknix_nat6 2>/dev/null
        nft delete table ip6 rocknix_filter6 2>/dev/null
    fi
}

# --- 5. SYSTEM OPERATIONS ---

ensure_dirs() {
    if [ ! -d "$STORAGE_NET_DIR" ]; then 
        mkdir -p "$STORAGE_NET_DIR" || { log_error "Failed to create directory $STORAGE_NET_DIR"; return 1; }
    fi
    if [ ! -d "${STATE_DIR}/iwd" ]; then 
        mkdir -p "${STATE_DIR}/iwd" || { log_error "Failed to create ${STATE_DIR}/iwd"; return 1; }
    fi
    if [ ! -d "${STORAGE_PROFILES_DIR}" ]; then
        mkdir -p "${STORAGE_PROFILES_DIR}" || { log_error "Failed to create ${STORAGE_PROFILES_DIR}"; return 1; }
    fi
    if [ ! -d "${STORAGE_RESOLVED_DIR}" ]; then
        mkdir -p "${STORAGE_RESOLVED_DIR}" || { log_error "Failed to create ${STORAGE_RESOLVED_DIR}"; return 1; }
    fi
}

check_paths() {
    if [ ! -L "$ETC_NET_DIR" ] && [ "$ETC_NET_DIR" != "$STORAGE_NET_DIR" ]; then
        if [ "$(stat -c %i "$ETC_NET_DIR")" != "$(stat -c %i "$STORAGE_NET_DIR" 2>/dev/null)" ]; then
            log_info "WARNING: $ETC_NET_DIR does not point to $STORAGE_NET_DIR. Persistence may fail."
        fi
    fi
}

fix_permissions() {
    if [ -d "$STORAGE_NET_DIR" ]; then
        chmod 644 "${STORAGE_NET_DIR}"/*.netdev 2>/dev/null
        chmod 644 "${STORAGE_NET_DIR}"/*.network 2>/dev/null
    fi
    if [ -d "${STATE_DIR}/iwd" ]; then
        chmod 600 "${STATE_DIR}/iwd"/*.psk 2>/dev/null
        chmod 600 "${STATE_DIR}/iwd"/*.8021x 2>/dev/null
    fi
}

reload_networkd() {
    fix_permissions
    if systemctl is-active --quiet systemd-networkd; then
        networkctl reload
    else
        log_info "Networkd not running, skipping reload."
    fi
}

reconfigure_iface() {
    local iface="$1"
    fix_permissions
    if systemctl is-active --quiet systemd-networkd; then
        if [ -n "$iface" ]; then
            networkctl reconfigure "$iface" 2>/dev/null || networkctl reload
        else
            networkctl reload
        fi
    fi
}

safe_symlink() {
    local target="$1"
    local link_name="$2"
    ensure_dirs
    local tmp_link="${link_name}.tmp"
    rm -f "$tmp_link" 2>/dev/null
    ln -sf "$target" "$tmp_link"
    if mv -T "$tmp_link" "$link_name" 2>/dev/null; then
        : 
    else
        mv "$tmp_link" "$link_name"
    fi
}

secure_write() {
    local dest="$1"
    local content="$2"
    local perms="${3:-644}"
    
    local tmp
    tmp=$(mktemp "${dest}.XXXXXX") || { log_error "Failed to create temp file"; return 1; }
    chmod "$perms" "$tmp"
    
    if ! printf "%b" "$content" > "$tmp"; then
        log_error "Failed to write content to $tmp"
        rm -f "$tmp"
        return 1
    fi
    
    sync
    if ! mv "$tmp" "$dest"; then
        log_error "Failed to move $tmp to $dest"
        rm -f "$tmp"
        return 1
    fi
}

deploy_config() {
    local template="$1"
    local destination="$2"
    local custom_ip="$3" 

    ensure_dirs
    if [ ! -f "$template" ]; then
        log_error "Missing template: $template"
        return 1
    fi

    if [ -n "$custom_ip" ]; then
        if ! validate_ip "$custom_ip"; then
            log_error "Invalid IP format for custom config: $custom_ip"
            return 1
        fi
        local tmp
        tmp=$(mktemp "${destination}.XXXXXX") || return 1
        chmod 644 "$tmp"
        cp "$template" "$tmp"
        
        if grep -q "^Address=" "$tmp"; then
            sed -i "s|^Address=.*|Address=${custom_ip}|g" "$tmp"
        else
            sed -i "/\[Network\]/a Address=${custom_ip}" "$tmp"
        fi
        mv "$tmp" "$destination"
    else
        safe_symlink "$template" "$destination"
    fi
}

get_wifi_iface() {
    local preferred="$1"
    if [ -n "$preferred" ]; then echo "$preferred"; return; fi
    # Check for wireless capability first (fast)
    for iface in /sys/class/net/*; do
        [ ! -e "$iface" ] && continue
        if [ -d "$iface/wireless" ] || [ -d "$iface/phy80211" ]; then
            basename "$iface"
            return 0
        fi
    done
    # Fallback to naming convention
    for iface in /sys/class/net/*; do
        local name=$(basename "$iface")
        if [[ "$name" == wlan* ]] || [[ "$name" == mlan* ]]; then
            echo "$name"
            return 0
        fi
    done
    return 1
}

tune_network_stack() {
    local profile="$1"
    if [ -w /proc/sys/net/ipv4/ip_forward ]; then
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    fi
    if [ -w /proc/sys/net/ipv4/conf/all/rp_filter ]; then
        sysctl -w net.ipv4.conf.all.rp_filter=1 >/dev/null 2>&1
    fi
    if [ -w /proc/sys/net/ipv6/conf/all/forwarding ]; then
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
    fi
    if [ "$profile" == "host" ] && [ -w /proc/sys/net/ipv4/ip_local_port_range ]; then
        sysctl -w net.ipv4.ip_local_port_range="1024 65535" >/dev/null 2>&1
    fi
}

# --- 6. LIFECYCLE ACTIONS ---

action_setup() {
    log_info "Initializing Network Manager..."
    ensure_dirs
    check_paths
    
    if [ -d /run/systemd/netif ]; then
        chown -R systemd-network:systemd-network /run/systemd/netif 2>/dev/null || true
    fi

    if [ -d "$STORAGE_WIFI_DIR" ]; then
        cp "$STORAGE_WIFI_DIR"/*.psk "${STATE_DIR}/iwd/" 2>/dev/null
    fi

    mkdir -p "$RUN_DIR"
    rm -f "${RUN_DIR}/hosts"
    if [ -f "${CONF_DIR}/hosts.conf" ]; then
        cat "${CONF_DIR}/hosts.conf" > "${RUN_DIR}/hosts"
    fi

    fix_permissions
    tune_network_stack "client"
    rfkill unblock all 2>/dev/null
    log_info "Setup complete."
}

action_reload() {
    log_info "Reloading configuration..."
    ensure_dirs
    fix_permissions
    reload_networkd
    log_info "Reload complete."
}

action_stop() {
    systemctl stop iwd 2>/dev/null
    log_info "Wireless services stopped."
}

# --- 7. VIRTUAL DEVICES & PAN ---

action_create_bridge() {
    local name="$1"
    [ -z "$name" ] && { jq -n '{error: "Bridge name required"}'; return 1; }
    
    ensure_dirs
    local netdev_file="${STORAGE_NET_DIR}/60-bridge-${name}.netdev"
    local content="[NetDev]\nName=${name}\nKind=bridge\n"
    
    secure_write "$netdev_file" "$content" "644"
    reload_networkd
    jq -n --arg name "$name" '{success: true, type: "bridge", created: $name}'
}

action_create_vlan() {
    local parent="$1"; local name="$2"; local id="$3"
    [ -z "$parent" ] && { jq -n '{error: "Parent interface required"}'; return 1; }
    [ -z "$name" ] && { jq -n '{error: "VLAN name required"}'; return 1; }
    [ -z "$id" ] && { jq -n '{error: "VLAN ID required"}'; return 1; }
    
    if [ "$id" -lt 1 ] || [ "$id" -gt 4094 ]; then
        jq -n '{error: "VLAN ID must be 1-4094"}'
        return 1
    fi
    
    ensure_dirs
    local netdev_file="${STORAGE_NET_DIR}/60-vlan-${name}.netdev"
    local netdev_content="[NetDev]\nName=${name}\nKind=vlan\n[VLAN]\nId=${id}\n"
    
    secure_write "$netdev_file" "$netdev_content" "644"
    
    local parent_cfg="${STORAGE_NET_DIR}/75-config-${parent}.network"
    if [ -f "$parent_cfg" ]; then
        if ! grep -q "VLAN=${name}" "$parent_cfg"; then
            if grep -q "\[Network\]" "$parent_cfg"; then
                sed -i "/\[Network\]/a VLAN=${name}" "$parent_cfg"
            else
                printf "\n[Network]\nVLAN=%s\n" "$name" >> "$parent_cfg"
            fi
        fi
    else
        local content=$(build_network_config "$parent" "" "yes" "Parent for VLAN ${name}" "" "" "" "" "$name")
        secure_write "$parent_cfg" "$content" "644"
    fi
    
    reload_networkd
    jq -n --arg name "$name" --arg parent "$parent" --arg id "$id" '{success: true, type: "vlan", created: $name, parent: $parent, id: $id}'
}

action_set_member() {
    local iface="$1"; local bridge="$2"
    [ -z "$iface" ] && { jq -n '{error: "Interface required"}'; return 1; }
    [ -z "$bridge" ] && { jq -n '{error: "Bridge name required"}'; return 1; }
    
    ensure_dirs
    local cfg_file="${STORAGE_NET_DIR}/75-config-${iface}.network"
    local content=$(build_network_config "$iface" "" "no" "Bridge Member" "" "" "" "$bridge")
    
    secure_write "$cfg_file" "$content" "644"
    reconfigure_iface "$iface"
    jq -n --arg iface "$iface" --arg bridge "$bridge" '{success: true, action: "set_member", interface: $iface, master: $bridge}'
}

action_delete_netdev() {
    local name="$1"
    [ -z "$name" ] && { jq -n '{error: "Device name required"}'; return 1; }
    local found="false"
    for f in "${STORAGE_NET_DIR}/60-bridge-${name}.netdev" "${STORAGE_NET_DIR}/60-vlan-${name}.netdev"; do
        if [ -f "$f" ]; then
            rm -f "$f"
            found="true"
        fi
    done
    if [ "$found" == "true" ]; then
        reload_networkd
        jq -n --arg name "$name" '{success: true, deleted: $name}'
    else
        jq -n --arg name "$name" '{error: "Device configuration not found"}'
    fi
}

action_pan_net() {
    local cmd="$1"
    local pin="$2"
    local name="$3"
    local custom_ip="$4"
    local mode="$5"
    local share="$6"
    
    check_paths
    
    # Defaults
    : "${mode:=client}"
    
    case "$cmd" in
        enable)
            # PIN Handling
            if [ -n "$pin" ]; then secure_write "$STORAGE_BT_PIN_FILE" "$pin" "600"; fi
            
            # Alias Handling
            if [ -n "$name" ] && command -v bluetoothctl >/dev/null; then
                if validate_bluetooth_name "$name"; then
                    bluetoothctl system-alias "$name" >/dev/null 2>&1
                else
                    log_error "Invalid bluetooth alias: $name"
                fi
            fi

            # Mode Logic
            if [ "$mode" == "host" ] || [ "$mode" == "nap" ]; then
                # Host/NAP Mode: Acts as Gateway (LAN)
                # Implicitly enable sharing if we are enabling host mode, unless explicitly disabled?
                # We assume host mode usually implies sharing for PAN (tethering source)
                local is_share="true"
                if [ "$share" == "false" ]; then is_share="false"; fi
                
                local use_ip="$custom_ip" # Let builder handle defaults if empty
                
                local content=$(build_gateway_config "bnep*" "$use_ip" "$is_share" "Bluetooth PAN Host (NAP)")
                secure_write "$STORAGE_PAN_NET_FILE" "$content" "644"
                
                tune_network_stack "host"
                if [ "$is_share" == "true" ]; then 
                    # Passing wild card bnep+ as LAN interface for PAN
                    enable_nat_masquerade "bnep+" 
                fi
                
            else
                # Client/PANU Mode: Connects to Phone (WAN)
                # Standard DHCP Client config, enables Masquerade in case we want to share THIS connection later
                local content=$(build_network_config "bnep*" "" "yes" "Bluetooth PAN Client (PANU)")
                secure_write "$STORAGE_PAN_NET_FILE" "$content" "644"
                
                tune_network_stack "client"
                disable_nat_masquerade
            fi
            
            reload_networkd
            jq -n --arg mode "$mode" '{success: true, status: "enabled", mode: $mode}'
            ;;
            
        disable)
            rm -f "$STORAGE_PAN_NET_FILE"
            reload_networkd
            tune_network_stack "client"
            disable_nat_masquerade
            jq -n '{success: true, status: "disabled"}'
            ;;
        *) exit 1 ;;
    esac
}

# --- 8. INTERFACE CONFIGURATION ---

action_set_dhcp() {
    local iface="$1"; local ssid="$2"; local dns="$3"; local domains="$4"; local routes="$5"
    [ -z "$iface" ] && { log_error "Interface required"; return 1; }
    
    local cfg_file=""
    if [ -n "$ssid" ]; then
        local safe_ssid
        if ! safe_ssid=$(sanitize_ssid "$ssid"); then
            jq -n '{error: "Invalid SSID"}'
            return 1
        fi
        cfg_file="${STORAGE_NET_DIR}/75-config-${iface}-${safe_ssid}.network"
    else
        cfg_file="${STORAGE_NET_DIR}/75-config-${iface}.network"
        rm -f "${STORAGE_NET_DIR}/75-static-${iface}.network" 2>/dev/null
    fi
    
    if [ -n "$dns" ] || [ -n "$domains" ] || [ -n "$routes" ]; then
        if [ -n "$dns" ] && ! validate_dns "$dns"; then
             jq -n '{error: "Invalid DNS server IP(s)"}'
             return 1
        fi
        if [ -n "$routes" ] && ! validate_routes "$routes"; then
             jq -n '{error: "Invalid routes format"}'
             return 1
        fi
    
        ensure_dirs
        local content=$(build_network_config "$iface" "$ssid" "yes" "User Config (DHCP + Overrides)" "" "" "$dns" "" "" "$domains" "" "$routes")
        secure_write "$cfg_file" "$content" "644"
        reconfigure_iface "$iface"
        tune_network_stack "client"
        jq -n --arg file "$cfg_file" '{success: true, mode: "dhcp (custom)", file: $file}'
    else
        if [ -f "$cfg_file" ]; then
            rm -f "$cfg_file"
            reconfigure_iface "$iface"
            tune_network_stack "client"
            jq -n --arg file "$cfg_file" '{success: true, mode: "dhcp (default)", removed_config: $file}'
        else
            jq -n --arg file "$cfg_file" '{success: true, message: "Already default", target: $file}'
        fi
    fi
}

action_set_static() {
    local iface="$1"; local ip="$2"; local gw="$3"; local dns="$4"; local ssid="$5"; local domains="$6"; local routes="$7"
    [ -z "$iface" ] && { log_error "Interface required"; return 1; }
    [ -z "$ip" ] && { log_error "IP required"; return 1; }
    
    if ! validate_ip "$ip"; then
        jq -n --arg ip "$ip" '{error: "Invalid IP", ip: $ip}'
        return 1
    fi
    if [ -n "$gw" ] && ! validate_ip "$gw"; then
        jq -n --arg gw "$gw" '{error: "Invalid Gateway IP", gateway: $gw}'
        return 1
    fi
    if [ -n "$dns" ] && ! validate_dns "$dns"; then
          jq -n '{error: "Invalid DNS server IP(s)"}'
          return 1
    fi
    if [ -n "$routes" ] && ! validate_routes "$routes"; then
          jq -n '{error: "Invalid routes format"}'
          return 1
    fi
    
    ensure_dirs
    if [[ "$ip" != *"/"* ]]; then ip="${ip}/24"; fi
    
    local cfg_file=""
    if [ -n "$ssid" ]; then
        local safe_ssid
        if ! safe_ssid=$(sanitize_ssid "$ssid"); then
            jq -n '{error: "Invalid SSID"}'
            return 1
        fi
        cfg_file="${STORAGE_NET_DIR}/75-config-${iface}-${safe_ssid}.network"
    else
        cfg_file="${STORAGE_NET_DIR}/75-config-${iface}.network"
    fi
    
    local content=$(build_network_config "$iface" "$ssid" "no" "User Config (Static)" "$ip" "$gw" "$dns" "" "" "$domains" "" "$routes")
    secure_write "$cfg_file" "$content" "644"
    reconfigure_iface "$iface"
    jq -n --arg file "$cfg_file" '{success: true, mode: "static", file: $file}'
}

action_set_link() {
    local iface="$1"; local ipv4="$2"; local ipv6="$3"
    [ -z "$iface" ] && { log_error "Interface required"; return 1; }
    ensure_dirs
    local cfg_file="${STORAGE_NET_DIR}/75-config-${iface}.network"
    
    local ll="yes"; local ra="yes"; local dhcp="yes"
    if [[ "$ipv4" == "off" ]]; then dhcp="ipv6"; ll="ipv6"; fi
    if [[ "$ipv6" == "off" ]]; then dhcp="ipv4"; ra="no"; ll="ipv4"; fi
    if [[ "$ipv4" == "off" ]] && [[ "$ipv6" == "off" ]]; then dhcp="no"; ll="no"; ra="no"; fi
    
    local content="[Match]\nName=${iface}\n\n[Network]\nDescription=User Config (Link Toggles)\n"
    content+="DHCP=${dhcp}\nLinkLocalAddressing=${ll}\nIPv6AcceptRA=${ra}\n"
    
    secure_write "$cfg_file" "$content" "644"
    reconfigure_iface "$iface"
    jq -n '{success: true, config: "updated"}'
}

action_set_mac_randomization() {
    local iface="$1"; local policy="$2"
    [ -z "$iface" ] && { jq -n '{error: "Interface required"}'; return 1; }
    # Policies: persistent, random, none, kernel
    if [[ ! "$policy" =~ ^(persistent|random|none|kernel)$ ]]; then
        jq -n '{error: "Invalid MAC policy. Use: persistent, random, none, or kernel"}'
        return 1
    fi

    ensure_dirs
    local cfg_file="${STORAGE_NET_DIR}/75-config-${iface}.network"
    
    # Safe rebuild approach:
    # 1. If file exists, try to preserve content while inserting/updating [Link]
    # 2. If not, create fresh.
    
    if [ -f "$cfg_file" ]; then
        # Check if [Link] section already exists
        if grep -q "\[Link\]" "$cfg_file"; then
            if grep -q "MACAddressPolicy=" "$cfg_file"; then
                sed -i "s/^MACAddressPolicy=.*/MACAddressPolicy=${policy}/" "$cfg_file"
            else
                sed -i "/\[Link\]/a MACAddressPolicy=${policy}" "$cfg_file"
            fi
        else
            # No [Link] section. We must insert it. 
            # Stricter approach: Insert before [Network]. If [Network] not found, append.
            if grep -q "\[Network\]" "$cfg_file"; then
                sed -i "/\[Network\]/i [Link]\nMACAddressPolicy=${policy}\n" "$cfg_file"
            else
                # Fallback: append to end if no [Network] found (unlikely for valid file)
                printf "\n[Link]\nMACAddressPolicy=${policy}\n" >> "$cfg_file"
            fi
        fi
    else
        # Create minimal config with MAC policy
        local content="[Match]\nName=${iface}\n\n[Link]\nMACAddressPolicy=${policy}\n\n[Network]\nDHCP=yes\nLinkLocalAddressing=yes\nIPv6AcceptRA=yes\n"
        secure_write "$cfg_file" "$content" "644"
    fi
    
    reconfigure_iface "$iface"
    jq -n --arg iface "$iface" --arg policy "$policy" '{success: true, action: "set_mac_policy", interface: $iface, policy: $policy}'
}

action_set_proxy() {
    local iface="$1"; local http="$2"; local https="$3"; local noproxy="$4"
    
    local target_file="$STORAGE_PROXY_GLOBAL"
    local scope="global"
    
    if [ -n "$iface" ]; then
        target_file="${STORAGE_NET_DIR}/proxy-${iface}.conf"
        scope="interface: $iface"
    fi
    
    if [ -z "$http" ] && [ -z "$https" ] && [ -z "$noproxy" ]; then
        if [ -f "$target_file" ]; then
            rm -f "$target_file"
            jq -n --arg scope "$scope" '{success: true, action: "cleared_proxy", scope: $scope}'
            return 0
        fi
        jq -n --arg scope "$scope" '{success: true, message: "No proxy configured", scope: $scope}'
        return 0
    fi

    if [ -n "$http" ] && ! validate_proxy_url "$http"; then
        jq -n '{error: "Invalid HTTP Proxy URL. Use format proto://host:port"}'
        return 1
    fi
    if [ -n "$https" ] && ! validate_proxy_url "$https"; then
        jq -n '{error: "Invalid HTTPS Proxy URL. Use format proto://host:port"}'
        return 1
    fi

    local content="# Proxy Configuration ($scope)\n"
    [ -n "$http" ] && content+="http_proxy=\"$http\"\nHTTP_PROXY=\"$http\"\n"
    [ -n "$https" ] && content+="https_proxy=\"$https\"\nHTTPS_PROXY=\"$https\"\n"
    [ -n "$noproxy" ] && content+="no_proxy=\"$noproxy\"\nNO_PROXY=\"$noproxy\"\n"
    
    # P0 Fix: Proxy config often contains credentials, must be 600
    secure_write "$target_file" "$content" "600"
    jq -n --arg scope "$scope" '{success: true, action: "set_proxy", scope: $scope}'
}

action_set_country() {
    local code="$1"
    [ -z "$code" ] && { jq -n '{error: "Country code required"}'; return 1; }
    if ! validate_country "$code"; then jq -n '{error: "Invalid country"}'; return 1; fi
    ensure_dirs
    if iw reg set "$code" 2>/dev/null; then
        echo "$code" > "$STORAGE_COUNTRY_FILE"
        jq -n '{success: true, country: $code}'
    else
        jq -n '{success: false, error: "Failed to set country"}'
    fi
}

action_set_global_dns() {
    local dns="$1"
    local domains="$2"

    # If no args, clear config
    if [ -z "$dns" ] && [ -z "$domains" ]; then
        if [ -f "$STORAGE_RESOLVED_FILE" ]; then
            rm -f "$STORAGE_RESOLVED_FILE"
            if systemctl is-active --quiet systemd-resolved; then
                systemctl restart systemd-resolved 2>/dev/null
            fi
            jq -n '{success: true, action: "cleared_global_dns"}'
            return 0
        fi
        jq -n '{success: true, message: "No global DNS configured"}'
        return 0
    fi

    if [ -n "$dns" ] && ! validate_dns "$dns"; then
        jq -n '{error: "Invalid DNS server IP(s)"}'
        return 1
    fi

    ensure_dirs

    local content="[Resolve]\n"
    # systemd-resolved expects space-separated list for DNS=
    if [ -n "$dns" ]; then
        # Input is comma separated, convert to space
        local dns_spaced="${dns//,/ }"
        content+="DNS=${dns_spaced}\n"
    fi
    
    if [ -n "$domains" ]; then
        local domains_spaced="${domains//,/ }"
        content+="Domains=${domains_spaced}\n"
    fi

    secure_write "$STORAGE_RESOLVED_FILE" "$content" "644"
    
    # Reload resolved
    if systemctl is-active --quiet systemd-resolved; then
        systemctl restart systemd-resolved
    fi
    
    jq -n --arg dns "$dns" --arg domains "$domains" '{success: true, action: "set_global_dns", dns: $dns, domains: $domains}'
}

# --- 9. PROFILE MANAGEMENT (Lightweight/Filesystem based) ---

action_profile() {
    local cmd="$1"; local name="$2"; local iface="$3"
    [ -z "$iface" ] && { jq -n '{error: "Interface required for profile operations"}'; return 1; }
    
    ensure_dirs
    local profile_iface_dir="${STORAGE_PROFILES_DIR}/${iface}"
    mkdir -p "$profile_iface_dir"
    
    local active_cfg="${STORAGE_NET_DIR}/75-config-${iface}.network"
    local profile_path="${profile_iface_dir}/${name}.network"

    case "$cmd" in
        save)
            [ -z "$name" ] && { jq -n '{error: "Profile name required"}'; return 1; }
            
            # We save the Generic config. If a WiFi SSID-specific config exists, warning:
            local wifi_specific="${STORAGE_NET_DIR}/75-config-${iface}-*.network"
            if ls $wifi_specific 1> /dev/null 2>&1; then
                 # If user tries to save a profile but we have a specific SSID bind, 
                 # we technically can't save the "state" easily without knowing which one they mean.
                 # For simplicity, we only support saving the generic interface config.
                 log_info "Note: Saving generic interface config. SSID-specific configs are ignored."
            fi
            
            if [ ! -f "$active_cfg" ]; then
                jq -n --arg iface "$iface" '{error: "No active generic config found for interface to save", interface: $iface}'
                return 1
            fi
            
            cp "$active_cfg" "$profile_path"
            jq -n --arg name "$name" --arg iface "$iface" '{success: true, action: "profile_saved", name: $name, interface: $iface}'
            ;;
            
        load)
            [ -z "$name" ] && { jq -n '{error: "Profile name required"}'; return 1; }
            
            if [ ! -f "$profile_path" ]; then
                jq -n --arg name "$name" '{error: "Profile not found", name: $name}'
                return 1
            fi
            
            # Remove existing generic config and replace
            rm -f "$active_cfg"
            cp "$profile_path" "$active_cfg"
            
            reconfigure_iface "$iface"
            jq -n --arg name "$name" --arg iface "$iface" '{success: true, action: "profile_loaded", name: $name, interface: $iface}'
            ;;
            
        list)
            local files
            files=$(ls "$profile_iface_dir"/*.network 2>/dev/null | xargs -n 1 basename 2>/dev/null | sed 's/\.network$//')
            # Generate JSON array of strings
            local json_list="[]"
            if [ -n "$files" ]; then
                 json_list=$(echo "$files" | jq -R . | jq -s .)
            fi
            jq -n --arg iface "$iface" --argjson profiles "$json_list" '{success: true, interface: $iface, profiles: $profiles}'
            ;;
            
        delete)
             [ -z "$name" ] && { jq -n '{error: "Profile name required"}'; return 1; }
             if [ -f "$profile_path" ]; then
                 rm -f "$profile_path"
                 jq -n --arg name "$name" '{success: true, action: "profile_deleted"}'
             else
                 jq -n --arg name "$name" '{error: "Profile not found"}'
             fi
             ;;
        *)
            jq -n '{error: "Invalid profile command. Use: save, load, list, delete"}'
            return 1
            ;;
    esac
}

action_host() {
    local ssid="$1"
    local pass="$2"
    local mode="${3:-ap}" # Default to AP
    local share="$4"
    local ip="$5"
    local iface="$6"
    local channel="$7"
    
    [ -z "$ssid" ] && { log_error "SSID required"; return 1; }
    [ -z "$iface" ] && iface=$(get_wifi_iface)
    
    ensure_dirs
    check_paths
    
    # Fallback to stdin for password if missing
    if [ -z "$pass" ] && [ ! -t 0 ]; then read -r pass; fi
    
    if ! validate_passphrase "$pass"; then
        jq -n '{success: false, error: "Passphrase must be 8-63 characters"}'
        return 1
    fi
    
    if [ -n "$channel" ] && ! validate_channel "$channel"; then
        jq -n '{success: false, error: "Invalid channel"}'
        return 1
    fi
    
    # Defaults based on mode
    local use_ip=""
    local use_share="false"
    
    if [ "$mode" == "ap" ]; then
        # AP mode usually implies Gateway/Router
        use_share="true"
    else
        # AdHoc/P2P mode defaults to Link Local (share=false)
        use_share="false"
    fi
    
    # Allow overrides
    if [ -n "$ip" ]; then use_ip="$ip"; fi
    if [ -n "$share" ]; then use_share="$share"; fi
    
    # Normalize IP if present
    if [ -n "$use_ip" ] && [[ "$use_ip" != *"/"* ]]; then use_ip="${use_ip}/24"; fi
    
    # Build Network Configuration
    local host_file="${STORAGE_NET_DIR}/70-wifi-host-${iface}.network"
    local content=$(build_gateway_config "$iface" "$use_ip" "$use_share" "WiFi Host Mode ($mode)")
    
    secure_write "$host_file" "$content" "644"
    
    reload_networkd
    tune_network_stack "host"
    
    if [ "$use_share" == "true" ]; then
        enable_nat_masquerade "$iface"
    else
        disable_nat_masquerade
    fi
    
    # Disconnect station mode before starting host
    iwctl station "$iface" disconnect >/dev/null 2>&1
    
    local res=""
    
    case "$mode" in
        adhoc|p2p)
            res=$(iwctl ad-hoc "$iface" start "$ssid" "$pass" 2>&1)
            ;;
        ap|*)
            if [ -n "$channel" ]; then
                 mkdir -p "${STATE_DIR}/iwd/ap"
                 local ap_conf="[General]\nChannel=${channel}\n[Security]\nPassphrase=${pass}\n"
                 secure_write "${STATE_DIR}/iwd/ap/${ssid}.ap" "$ap_conf" "600"
                 res=$(iwctl ap "$iface" start-profile "$ssid" 2>&1)
            else
                 res=$(iwctl ap "$iface" start "$ssid" "$pass" 2>&1)
            fi
            ;;
    esac
    
    if [ $? -eq 0 ]; then
        jq -n --arg mode "$mode" --arg ip "$use_ip" --arg share "$use_share" '{success: true, mode: $mode, ip: $ip, sharing: $share}'
    else
        rm -f "$host_file"
        rm -f "${STATE_DIR}/iwd/ap/${ssid}.ap"
        reload_networkd
        disable_nat_masquerade
        jq -n --arg err "$res" '{success: false, error: $err}'
    fi
}

action_share() {
    local iface="$1"
    local ip="$2"
    [ -z "$iface" ] && { log_error "Interface required"; return 1; }
    
    # If explicit IP not provided, let builder choose defaults based on share=true
    local use_ip="$ip"
    if [ -n "$use_ip" ] && [[ "$use_ip" != *"/"* ]]; then use_ip="${use_ip}/24"; fi
    
    ensure_dirs
    # Clean up existing client configs for this iface to avoid conflicts
    rm -f "${STORAGE_NET_DIR}"/75-config-${iface}*.network
    rm -f "${STORAGE_NET_DIR}/70-wifi-host-${iface}.network"
    
    local share_file="${STORAGE_NET_DIR}/70-share-${iface}.network"
    local content=$(build_gateway_config "$iface" "$use_ip" "true" "Shared Connection (Gateway)")
    
    secure_write "$share_file" "$content" "644"
    reload_networkd
    tune_network_stack "host"
    enable_nat_masquerade "$iface"
    
    jq -n --arg iface "$iface" --arg ip "$use_ip" '{success: true, mode: "share/gateway", interface: $iface, ip: $ip}'
}

action_client() {
    local iface="$1"
    [ -z "$iface" ] && iface=$(get_wifi_iface)
    
    # Remove host/share config for this specific interface
    rm -f "${STORAGE_NET_DIR}/70-wifi-host-${iface}.network"
    rm -f "${STORAGE_NET_DIR}/70-share-${iface}.network"
    
    # Also clean up legacy global file if it exists
    rm -f "$STORAGE_HOST_NET_FILE"
    
    reload_networkd
    disable_nat_masquerade
    
    # WiFi cleanup steps
    if [ -d "/sys/class/net/$iface/wireless" ] || [ -d "/sys/class/net/$iface/phy80211" ]; then
        iwctl ap "$iface" stop >/dev/null 2>&1
        iwctl ad-hoc "$iface" stop >/dev/null 2>&1
        iwctl station "$iface" scan >/dev/null 2>&1
    fi
    
    tune_network_stack "client"
    jq -n '{success: true, mode: "client"}'
}

action_reset() {
    local iface="$1"
    [ -z "$iface" ] && iface=$(get_wifi_iface)
    if [ -z "$iface" ] || [ ! -d "/sys/class/net/$iface" ]; then jq -n '{error: "Interface not found"}'; return 1; fi
    log_info "Resetting interface $iface"
    ip link set "$iface" down; sleep 1; ip link set "$iface" up
    reconfigure_iface "$iface"
    jq -n '{success: true}'
}

