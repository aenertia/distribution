action_wps() {
    local iface="$1"
    [ -z "$iface" ] && iface=$(get_wifi_iface)
    
    iwctl station "$iface" wps-push-button >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        jq -n '{success: true, message: "WPS Push Button mode active"}'
    else
        jq -n '{success: false, error: "Failed to start WPS"}'
    fi
}

action_scan() {
    local iface="$1"
    [ -z "$iface" ] && iface=$(get_wifi_iface)
    if [ -z "$iface" ]; then 
        jq -n '{error: "No wireless interface"}'
        return 1;
    fi
    
    # Verify busctl availability (Zero production impact strategy)
    if ! command -v busctl >/dev/null 2>&1; then
        jq -n '{
            error: "busctl not found",
            detail: "WiFi scanning requires busctl (part of systemd)",
            solution: "Install systemd or systemd-utils package",
            note: "iwd requires systemd DBus, so this indicates a system misconfiguration"
        }'
        return 1
    fi
    
    ip link set "$iface" up >/dev/null 2>&1
    
    # Get IWD device path via DBus
    local objects_json
    if ! objects_json=$(busctl call net.connman.iwd / \
        org.freedesktop.DBus.ObjectManager GetManagedObjects \
        --json=short 2>/dev/null); then
        jq -n '{error: "Failed to query IWD. Is iwd running?"}'
        return 1
    fi
    
    local device_path
    device_path=$(echo "$objects_json" | jq -r --arg iface "$iface" '
        .data[0] | to_entries[] | 
        select(.value["net.connman.iwd.Device"].Name.data == $iface) | 
        .key')
    
    if [ -z "$device_path" ] || [ "$device_path" == "null" ]; then
        jq -n --arg iface "$iface" '{
            error: "Interface not managed by IWD",
            interface: $iface,
            solution: "Check that iwd is running and managing this interface"
        }'
        return 1
    fi
    
    # Trigger scan
    if ! busctl call net.connman.iwd "$device_path" \
        net.connman.iwd.Station Scan >/dev/null 2>&1; then
        log_info "Scan trigger failed (device may be busy)"
    fi
    
    # Poll for scan completion
    # Matches existing SCAN_POLL_MS configuration (100ms)
    local max_polls=$((SCAN_TIMEOUT * 1000 / SCAN_POLL_MS))
    for ((i=1; i<=max_polls; i++)); do
        local scanning
        scanning=$(busctl get-property net.connman.iwd "$device_path" \
            net.connman.iwd.Station Scanning --json=short 2>/dev/null | \
            jq -r '.data')
        [ "$scanning" != "true" ] && break
        sleep 0.1
    done
    
    sleep 0.2  # Allow scan results to stabilize
    
    # Fetch scan results
    objects_json=$(busctl call net.connman.iwd / \
        org.freedesktop.DBus.ObjectManager GetManagedObjects \
        --json=short 2>/dev/null)
    
    # Parse networks with signal strength, known status, and sort
    echo "$objects_json" | jq -r --arg dev "$device_path" '
        [
            .data[0] | to_entries[] | 
            select(.value["net.connman.iwd.Network"] != null) |
            select(.value["net.connman.iwd.Network"].Device.data == $dev) |
            {
                ssid: .value["net.connman.iwd.Network"].Name.data,
                security: .value["net.connman.iwd.Network"].Type.data,
                connected: (.value["net.connman.iwd.Network"].Connected.data == true),
                known: (if .value["net.connman.iwd.Network"].KnownNetwork.data then true else false end),
                signal: (.value["net.connman.iwd.Network"].SignalStrength.data // -10000),
                strength_pct: (
                    (.value["net.connman.iwd.Network"].SignalStrength.data // -10000) as $sig |
                    (($sig / 100) + 100) * 2 |
                    if . > 100 then 100 elif . < 0 then 0 else . end | floor
                )
            }
        ] | unique_by(.ssid) | sort_by(-.signal)
    '
}

action_connect() {
    local ssid="$1"; local pass="$2"; local iface="$3"; local hidden="$4"
    if [ -n "$ssid" ]; then
        [ -z "$iface" ] && iface=$(get_wifi_iface)
        
        if [ -z "$pass" ] && [ ! -t 0 ]; then
            read -r pass
        fi
        
        ensure_dirs
        if [ -n "$pass" ]; then
            local psk_file="${STATE_DIR}/iwd/${ssid}.psk"
            secure_write "$psk_file" "[Security]\nPassphrase=${pass}\n" "600"
        fi
        local cmd="connect"
        if [[ "$hidden" == "true" ]]; then cmd="connect-hidden"; fi
        
        # Exponential backoff retry logic (P0/Should Do)
        local attempts=0
        local max_attempts=3
        local sleep_time=1
        local connected=0
        
        while [ $attempts -lt $max_attempts ]; do
            # Capture output to check for specific failure messages if needed
            iwctl station "$iface" "$cmd" "$ssid" >/dev/null 2>&1
            if [ $? -eq 0 ]; then
                connected=1
                break
            fi
            
            attempts=$((attempts+1))
            [ $attempts -lt $max_attempts ] && sleep "$sleep_time"
            sleep_time=$((sleep_time * 2))
        done
        
        if [ $connected -eq 1 ]; then jq -n '{success: true}'; else jq -n '{success: false}'; fi
    else
        jq -n '{error: "Missing SSID"}'
    fi
}

action_connect_enterprise() {
    local ssid="$1"; local identity="$2"; local password="$3"; local iface="$4"
    [ -z "$ssid" ] && { jq -n '{error: "SSID required"}'; return 1; }
    [ -z "$identity" ] && { jq -n '{error: "Identity required"}'; return 1; }
    [ -z "$password" ] && { jq -n '{error: "Password required"}'; return 1; }
    
    # Input Validation (P0/Must Do)
    if [ ${#identity} -lt 1 ] || [ ${#password} -lt 1 ]; then
        jq -n '{error: "Identity and password cannot be empty"}'
        return 1;
    fi

    [ -z "$iface" ] && iface=$(get_wifi_iface)
    
    ensure_dirs
    local eap_file="${STATE_DIR}/iwd/${ssid}.8021x"
    
    # Basic PEAP-MSCHAPv2 template (Most common)
    local content="[Security]\nEAP-Method=PEAP\nEAP-Identity=${identity}\nEAP-PEAP-Phase2-Method=MSCHAPV2\nEAP-PEAP-Phase2-Identity=${identity}\nEAP-PEAP-Phase2-Password=${password}\n"
    
    # settings: [Settings]\nAutoConnect=true\n
    
    secure_write "$eap_file" "$content" "600"
    
    local res=$(iwctl station "$iface" connect "$ssid" 2>&1)
    if [ $? -eq 0 ]; then
        jq -n '{success: true, type: "enterprise"}'
    else
        jq -n --arg err "$res" '{success: false, error: $err}'
    fi
}

action_forget() {
    local ssid="$1"
    rm -f "${STATE_DIR}/iwd/${ssid}.psk"
    rm -f "${STATE_DIR}/iwd/${ssid}.8021x"
    iwctl known-networks "$ssid" forget >/dev/null 2>&1
    jq -n '{success: true}'
}

action_disconnect() {
    local iface="$1"; [ -z "$iface" ] && iface=$(get_wifi_iface)
    if [[ "$iface" == wlan* ]]; then iwctl station "$iface" disconnect >/dev/null 2>&1; else ip link set "$iface" down; fi
    jq -n '{success: true}'
}

# --- 11. STATUS & DIAGNOSTICS ---

get_capabilities_json() {
    local has_wifi="false"; local has_eth="false"; local has_gadget="false"; local has_bt="false"
    local has_ts="false"; local has_zt="false"
    if ls /sys/class/net/wlan* 1> /dev/null 2>&1 || ls /sys/class/net/mlan* 1> /dev/null 2>&1; then has_wifi="true"; fi
    if ls /sys/class/udc/* 1> /dev/null 2>&1; then has_gadget="true"; fi
    if [ -d "/sys/class/bluetooth" ] && [ "$(ls -A /sys/class/bluetooth 2>/dev/null)" ]; then has_bt="true"; fi
    if command -v tailscale >/dev/null; then has_ts="true"; fi
    if command -v zerotier-cli >/dev/null; then has_zt="true"; fi

    jq -n --argjson wifi $has_wifi --argjson gadget $has_gadget --argjson bt $has_bt --argjson tailscale $has_ts --argjson zerotier $has_zt \
       '{ wifi: $wifi, gadget: $gadget, bluetooth: $bt, vpn: { tailscale: $tailscale, zerotier: $zerotier } }'
}

action_check_internet() {
    local simple="$1"
    local curl_fmt="%{http_code}:%{time_total}"
    local target="http://clients3.google.com/generate_204"
    
    local ipv4_working="false"
    local ipv6_working="false"
    local latency_v4=0
    local latency_v6=0
    
    local out_v4=$(curl -4 -s -o /dev/null -w "$curl_fmt" -m "$CURL_TIMEOUT" "$target" 2>/dev/null)
    if [[ "$(echo "$out_v4" | cut -d: -f1)" == "204" ]]; then
        ipv4_working="true"
        latency_v4=$(echo "$out_v4" | cut -d: -f2)
        if [[ "$simple" == "true" ]]; then echo "true"; return 0; fi
    fi
    
    if ip -6 addr | grep -q "inet6 [23]"; then
         local out_v6=$(curl -6 -s -o /dev/null -w "$curl_fmt" -m "$CURL_TIMEOUT" "$target" 2>/dev/null)
         if [[ "$(echo "$out_v6" | cut -d: -f1)" == "204" ]]; then
             ipv6_working="true"
             latency_v6=$(echo "$out_v6" | cut -d: -f2)
             if [[ "$simple" == "true" ]]; then echo "true"; return 0; fi
         fi
    fi
    
    if [[ "$simple" == "true" ]]; then echo "false"; return 1; fi

    local dns_working="false"
    if [[ "$ipv4_working" == "true" || "$ipv6_working" == "true" ]]; then
        dns_working="true"
    elif resolvectl query google.com >/dev/null 2>&1; then
        dns_working="true"
    fi
    
    jq -n \
       --argjson dns "$dns_working" \
       --argjson ipv4 "$ipv4_working" \
       --argjson ipv6 "$ipv6_working" \
       --arg lat4 "$latency_v4" \
       --arg lat6 "$latency_v6" \
       '{
         success: true, 
         internet: ($ipv4 or $ipv6),
         dns: $dns, 
         ipv4: { available: $ipv4, latency: $lat4 },
         ipv6: { available: $ipv6, latency: $lat6 }
       }'
}

action_status() {
    # PERFORMANCE OPTIMIZATION: BATCH PROCESSING
    # Instead of looping and spawning subshells, fetch all data at once.

    if [ -f "$STORAGE_COUNTRY_FILE" ]; then iw reg set "$(cat "$STORAGE_COUNTRY_FILE")" 2>/dev/null; fi
    
    local hostname=$(hostname 2>/dev/null || echo "ROCKNIX")
    
    # 1. Batch fetch IPs
    declare -A IP_MAP
    while read -r _ iface _ ip_cidr _; do
        IP_MAP["$iface"]="${ip_cidr%/*}"
    done < <(ip -o -4 addr show)

    # 2. Batch fetch Gateways
    declare -A GW_MAP
    # Format: default via 192.168.1.1 dev wlan0 proto dhcp ...
    while read -r line; do
        if [[ "$line" == *"default via"* ]]; then
             # Simple extraction avoiding awk if possible
             local gw=${line#*default via }
             gw=${gw%% *}
             local dev=${line#*dev }
             dev=${dev%% *}
             GW_MAP["$dev"]="$gw"
        fi
    done < <(ip -4 route show default)

    # 3. Batch fetch DNS (Restored P0)
    declare -A DNS_MAP
    if command -v resolvectl >/dev/null; then
        local current_iface=""
        # Parse resolvectl status. Note: Output format varies by systemd version.
        # Common format: "Link 2 (wlan0)" then "DNS Servers: 1.1.1.1"
        while IFS= read -r line; do
            if [[ "$line" =~ Link\ ([0-9]+)\ \(([^)]+)\) ]]; then
                current_iface="${BASH_REMATCH[2]}"
            elif [[ "$line" =~ DNS\ Servers:\ (.+) ]]; then
                DNS_MAP["$current_iface"]="${BASH_REMATCH[1]}"
            fi
        done < <(resolvectl status --no-pager 2>/dev/null)
    fi
    
    # 4. Check Internet (Lightweight)
    local internet="false"
    if [ ${#GW_MAP[@]} -gt 0 ]; then
        # Only ping if we have a gateway
        if timeout 1 ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then internet="true"; fi
    fi

    # 5. Pre-fetch Global Proxy
    local global_proxy_json=$(get_proxy_json "$STORAGE_PROXY_GLOBAL")

    # 6. Build Interface Array
    local iface_data=()
    
    for iface_path in /sys/class/net/*; do
        local iface=${iface_path##*/}
        [ "$iface" == "lo" ] && continue; [ "$iface" == "sit0" ] && continue; [ ! -e "$iface_path" ] && continue
        
        local ip="${IP_MAP[$iface]}"
        local gw="${GW_MAP[$iface]}"
        # Fast file read, no spawn
        local mac=$(< "$iface_path/address")
        local connected="false"; [ -n "$ip" ] && connected="true"
        local type="ethernet" # Default

        # Improved Type Detection via Sysfs
        if [ -d "$iface_path/wireless" ] || [ -d "$iface_path/phy80211" ]; then
            type="wifi"
        elif [ -d "$iface_path/bridge" ]; then
            type="bridge"
        elif [ -d "$iface_path/bonding" ]; then
            type="bond"
        elif [ -f "$iface_path/tun_flags" ]; then
            # Distinguish tun vs tap vs specific VPN software
            if [[ "$iface" == wg* ]] || [[ "$iface" == tailscale* ]] || [[ "$iface" == zt* ]]; then
                 type="vpn"
            else
                 type="tun"
            fi
        elif [ -f "/proc/net/vlan/$iface" ]; then
            type="vlan"
        elif [[ "$iface" == veth* ]]; then
            type="veth" # Container interfaces
        elif [[ "$iface" == docker* ]] || [[ "$iface" == br-* ]]; then
            type="bridge_container"
        elif [[ "$iface" == dummy* ]]; then
            type="dummy"
        elif [[ "$iface" == usb* ]] || [[ "$iface" == rndis* ]]; then
            type="gadget"
        elif [[ "$iface" == bnep* ]]; then
            type="bluetooth_pan"
        elif [[ "$iface" == wwan* ]]; then
            type="wwan"
        fi
        
        local ssid=""
        local mode="station"
        local dns="${DNS_MAP[$iface]}"
        local powersave=""
        
        # Optimize iwctl calls: only call if it's wifi and we have an IP or are seemingly active
        if [ "$type" == "wifi" ]; then
            # Cache the status output
            local iw_status=$(iwctl station "$iface" show 2>/dev/null)
            if echo "$iw_status" | grep -q "Connected network"; then
                 ssid=$(echo "$iw_status" | grep "Connected network" | sed 's/^\s*Connected network\s*//')
            elif iwctl ap "$iface" show 2>/dev/null | grep -q "Started"; then
                 mode="host"
                 ssid=$(iwctl ap "$iface" show | grep "Started" | awk '{print $2}')
            fi
            
            # Restored Power Save Detection (P0) with check
            if command -v iw >/dev/null; then
                 if iw dev "$iface" get power_save 2>/dev/null | grep -q "on"; then 
                     powersave="on"
                 else 
                     powersave="off"
                 fi
            fi
        fi

        local cfg_mode="dhcp"
        if [ -f "${STORAGE_NET_DIR}/75-config-${iface}.network" ]; then 
            if grep -q "Address=" "${STORAGE_NET_DIR}/75-config-${iface}.network"; then cfg_mode="static"; fi
        fi
        
        local iface_proxy_json=$(get_proxy_json "${STORAGE_NET_DIR}/proxy-${iface}.conf")
        
        # Build JSON object for this interface (using array to avoid O(n^2) string concat)
        iface_data+=("$(jq -n -c \
            --arg iface "$iface" --arg type "$type" --arg ip "$ip" --arg mac "$mac" --argjson connected "$connected" \
            --arg ssid "$ssid" --arg mode "$mode" --arg gw "$gw" --arg dns "$dns" --arg cfg "$cfg_mode" --arg ps "$powersave" \
            --argjson proxy "$iface_proxy_json" \
            '{ ($iface): { type: $type, ip: $ip, mac: $mac, connected: $connected, ssid: (if $ssid != "" then $ssid else null end), mode: $mode, gateway: $gw, dns: $dns, config_method: $cfg, powersave: $ps, proxy: $proxy } }')")
    done
    
    # Efficient Array Join
    local interfaces_json=$(printf '%s\n' "${iface_data[@]}" | jq -s 'add // {}')
    local caps_json=$(get_capabilities_json)
    
    jq -n --arg hn "$hostname" --argjson net "$internet" --argjson caps "$caps_json" \
          --argjson ifaces "$interfaces_json" --argjson gproxy "$global_proxy_json" \
          '{ hostname: $hn, internet_connected: $net, global_proxy: $gproxy, capabilities: $caps, interfaces: $ifaces }'
}

# --- 12. ARGUMENT PARSING ---

CMD=""
SUB_CMD=""
SKIP_HW=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --start|--setup|start) CMD="start"; shift ;;
        --stop|stop) CMD="stop"; shift ;;
        --reload|reload) CMD="reload"; shift ;;
        --restart|restart) CMD="restart"; shift ;;
        --help|-h|help) CMD="help"; shift ;;
        
        status) CMD="status"; shift ;;
        capabilities) CMD="capabilities"; shift ;;
        check-internet) CMD="check-internet"; shift ;;
        
        scan) CMD="scan"; shift ;;
        connect) CMD="connect"; shift ;;
        connect-enterprise) CMD="connect-enterprise"; shift ;;
        disconnect) CMD="disconnect"; shift ;;
        forget) CMD="forget"; shift ;;
        wps) CMD="wps"; shift ;;
        
        create-bridge) CMD="create-bridge"; shift ;;
        create-vlan) CMD="create-vlan"; shift ;;
        set-member) CMD="set-member"; shift ;;
        delete-link) CMD="delete-link"; shift ;;
        
        pan-net) CMD="pan-net"; shift ;;
        
        host) CMD="host"; shift ;;
        share) CMD="share"; shift ;;
        client) CMD="client"; shift ;;
        
        reset) CMD="reset"; shift ;;
        
        set-dhcp) CMD="set-dhcp"; shift ;;
        set-static) CMD="set-static"; shift ;;
        set-country) CMD="set-country"; shift ;;
        set-link) CMD="set-link"; shift ;;
        set-proxy) CMD="set-proxy"; shift ;;
        set-mac-policy) CMD="set-mac-policy"; shift ;;
        set-global-dns) CMD="set-global-dns"; shift ;;
        
        profile) CMD="profile"; shift ;;
        
        --ssid) ARG_SSID="$2"; shift 2 ;;
        --password) ARG_PASS="$2"; shift 2 ;;
        --interface) ARG_IFACE="$2"; shift 2 ;;
        --ip) ARG_IP="$2"; shift 2 ;;
        --gateway) ARG_GW="$2"; shift 2 ;;
        --dns) ARG_DNS="$2"; shift 2 ;;
        --domains) ARG_DOMAINS="$2"; shift 2 ;;
        --routes) ARG_ROUTES="$2"; shift 2 ;;
        --ipv4) ARG_V4="$2"; shift 2 ;;
        --ipv6) ARG_V6="$2"; shift 2 ;;
        --pin) ARG_PIN="$2"; shift 2 ;;
        --id) ARG_ID="$2"; shift 2 ;;
        --channel) ARG_CHANNEL="$2"; shift 2 ;;
        --code) ARG_CODE="$2"; shift 2 ;;
        --bridge) ARG_BRIDGE="$2"; shift 2 ;;
        --parent) ARG_PARENT="$2"; shift 2 ;;
        --name) ARG_NAME="$2"; shift 2 ;;
        --hidden) ARG_HIDDEN="true"; shift ;;
        --simple) ARG_SIMPLE="true"; shift ;;
        --mode) ARG_MODE="$2"; shift 2 ;;
        --http) ARG_HTTP="$2"; shift 2 ;;
        --https) ARG_HTTPS="$2"; shift 2 ;;
        --noproxy) ARG_NOPROXY="$2"; shift 2 ;;
        --identity) ARG_IDENTITY="$2"; shift 2 ;;
        --policy) ARG_POLICY="$2"; shift 2 ;;
        --share) ARG_SHARE="true"; shift ;;
        enable|disable|save|load|list|delete) SUB_CMD="$1"; shift ;;
        
        *) if [ -z "$CMD" ]; then CMD="status"; fi; shift ;;
    esac
done

if [ -z "$CMD" ]; then 
    if [ -t 0 ]; then CMD="status"; else CMD="start"; fi
fi

case "$CMD" in
    start) action_setup ;;
    stop) action_stop ;;
    restart) action_stop; action_setup ;;
    reload) action_reload ;;
    
    status) action_status ;;
    capabilities) get_capabilities_json ;;
    check-internet) action_check_internet "$ARG_SIMPLE" ;;
    
    scan) action_scan "$ARG_IFACE" ;;
    connect) action_connect "$ARG_SSID" "$ARG_PASS" "$ARG_IFACE" "$ARG_HIDDEN" ;;
    connect-enterprise) action_connect_enterprise "$ARG_SSID" "$ARG_IDENTITY" "$ARG_PASS" "$ARG_IFACE" ;;
    disconnect) action_disconnect "$ARG_IFACE" ;;
    forget) action_forget "$ARG_SSID" ;;
    wps) action_wps "$ARG_IFACE" ;;
    
    create-bridge) action_create_bridge "$ARG_NAME" ;;
    create-vlan) action_create_vlan "$ARG_PARENT" "$ARG_NAME" "$ARG_ID" ;;
    set-member) action_set_member "$ARG_IFACE" "$ARG_BRIDGE" ;;
    delete-link) action_delete_netdev "$ARG_NAME" ;;
    
    pan-net) action_pan_net "$SUB_CMD" "$ARG_PIN" "$ARG_SSID" "$ARG_IP" "$ARG_MODE" "$ARG_SHARE" ;;
    
    host) action_host "$ARG_SSID" "$ARG_PASS" "$ARG_MODE" "$ARG_SHARE" "$ARG_IP" "$ARG_IFACE" "$ARG_CHANNEL" ;;
    share) action_share "$ARG_IFACE" "$ARG_IP" ;;
    client) action_client "$ARG_IFACE" ;;
    
    set-dhcp) action_set_dhcp "$ARG_IFACE" "$ARG_SSID" "$ARG_DNS" "$ARG_DOMAINS" "$ARG_ROUTES" ;;
    set-static) action_set_static "$ARG_IFACE" "$ARG_IP" "$ARG_GW" "$ARG_DNS" "$ARG_SSID" "$ARG_DOMAINS" "$ARG_ROUTES" ;;
    set-link) action_set_link "$ARG_IFACE" "$ARG_V4" "$ARG_V6" ;;
    set-country) action_set_country "$ARG_CODE" ;;
    set-proxy) action_set_proxy "$ARG_IFACE" "$ARG_HTTP" "$ARG_HTTPS" "$ARG_NOPROXY" ;;
    set-mac-policy) action_set_mac_randomization "$ARG_IFACE" "$ARG_POLICY" ;;
    set-global-dns) action_set_global_dns "$ARG_DNS" "$ARG_DOMAINS" ;;
    
    profile) action_profile "$SUB_CMD" "$ARG_NAME" "$ARG_IFACE" ;;
    
    reset) action_reset "$ARG_IFACE" ;;
    
    help|*) 
