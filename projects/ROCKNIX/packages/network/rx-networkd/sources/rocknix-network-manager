        echo "      --interface <iface>"
        echo "  forget                  Forget a known WiFi network"
        echo "      --ssid <ssid>"
        echo ""
        echo "INTERFACE CONFIGURATION"
        echo "  set-dhcp                Enable DHCP on an interface"
