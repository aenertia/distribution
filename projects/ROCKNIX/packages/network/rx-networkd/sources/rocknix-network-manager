        echo "      --interface <iface> --ip <ip/cidr> [--gateway <gw>] [--dns <ip,ip>]"
        echo "      [--routes <dest:gw,dest>] (Add static routes)"
        echo "  set-mac-policy          Set MAC address randomization policy"
        echo "      --interface <iface> --policy <random|persistent|none|kernel>"
        echo "  set-proxy               Configure HTTP/HTTPS proxy"
        echo "      [--interface <iface>] --http <url> --https <url> [--noproxy <list>]"
