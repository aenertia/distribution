/*
 * RK3566 Optimized CPU Undervolt
 *
 * Single consolidated UV curve derived from 29-run power profiling
 * campaign using external USB-PD measurement (FNIRSI FNB58) across
 * RGB30, RG353P, and X55 devices. V²f power model fit R² > 0.993.
 *
 * Conservative floor across binned silicon: validated stable under
 * sustained emulation (Dolphin, PPSSPP, N64) and synthetic workloads
 * (7z 4T, glmark2-es2). Estimated 5-22% power reduction vs stock.
 *
 * For OC use: prefer rk3566-overclock-optimized (combined OC+UV).
 * This standalone overlay is for stock-clocked operation only.
 */
/dts-v1/;
/plugin/;

/ {
fragment@0 {
	target-path = "/opp-table-0";
	__overlay__ {
		opp-408000000  { opp-microvolt = <780000 780000 1150000>; };
		opp-600000000  { opp-microvolt = <790000 790000 1150000>; };
		opp-816000000  { opp-microvolt = <800000 800000 1150000>; };
		opp-1104000000 { opp-microvolt = <800000 800000 1150000>; };
		opp-1416000000 { opp-microvolt = <840000 840000 1150000>; };
		opp-1608000000 { opp-microvolt = <875000 875000 1150000>; };
		opp-1800000000 { opp-microvolt = <900000 900000 1150000>; };
		opp-1992000000 { opp-microvolt = <950000 950000 1150000>; };
	};
};
};
