 void GMainWindow::ToggleScreenLayout() {
+    // CustomLayout: 4-state stretch cycle for dual-screen devices
+    // L2 cycles: both stretched → top unstretch → both unstretch → top stretch → repeat
+    if (Settings::values.layout_option.GetValue() ==
+        Settings::LayoutOption::CustomLayout) {
+        bool top = Settings::values.screen_top_stretch.GetValue();
+        bool bot = Settings::values.screen_bottom_stretch.GetValue();
+
+        if (top && bot) {
+            // State 1→2: unstretch top (bottom stays stretched)
+            Settings::values.screen_top_stretch = false;
+        } else if (!top && bot) {
+            // State 2→3: unstretch bottom too (both letterboxed)
+            Settings::values.screen_bottom_stretch = false;
+        } else if (!top && !bot) {
+            // State 3→4: stretch top (bottom stays unstretched)
+            Settings::values.screen_top_stretch = true;
+        } else {
+            // State 4→1: stretch bottom (back to both stretched)
+            Settings::values.screen_bottom_stretch = true;
+        }
+        SyncMenuUISettings();
+        system.ApplySettings();
+        return;
+    }
