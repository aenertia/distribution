#!/bin/bash
# display-cycle: cycle display layout for dual-screen and HDMI/DP devices
# Usage: display-cycle move              — cycle ES between panels
#        display-cycle off               — cycle panel power off/on
#        display-cycle mirror            — toggle mirror mode
#        display-cycle scale-top         — cycle top panel scaling (stretch/fit/integer)
#        display-cycle scale-bottom      — cycle bottom panel scaling
#        display-cycle rotate-top        — cycle top panel rotation (8-state)
#        display-cycle rotate-bottom     — cycle bottom panel rotation (8-state)
#        display-cycle rotate-top-set N  — set top panel rotation (normal/90/180/270/flipped/...)
#        display-cycle rotate-bottom-set N — set bottom panel rotation
#
# Move cycle:   top → bottom-off → bottom → top-off → top
# Off cycle:    both-on → top-off → bottom-off → both-on
# Mirror:       GPU-driver-aware:
#   Same-res panels: sway output overlap (works on all drivers)
#   Cross-res + mesa (panfrost/freedreno/turnip): wl-mirror with scaling
#   Cross-res + libmali: sway overlap fallback (no scaling, wp_viewport bug)
#
# Updates WLR_CON so emulators launch on the correct output.

. /etc/profile
. /usr/lib/rocknix-display/display-core.sh

display_is_dual || exit 0

# Read current state
STATE="normal_top"
[ -f "$DISPLAY_STATE_FILE" ] && read -r STATE < "$DISPLAY_STATE_FILE"

# Aliases for readability (set by display-core.sh _display_init)
OUT1="$DISPLAY_PRIMARY"
OUT2="$DISPLAY_SECONDARY"

# --- Main command dispatch ---
case "$1" in
    move)
        display_kill_mirror
        case "$STATE" in
            normal_top)
                swaymsg "output ${OUT2} power off" 2>/dev/null
                echo "bottom_off" > "$DISPLAY_STATE_FILE"
                ;;
            bottom_off)
                display_stack_vertical
                swaymsg '[app_id="emulationstation"]' move to output "${OUT2}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                display_update_active "${OUT2}"
                echo "normal_bottom" > "$DISPLAY_STATE_FILE"
                ;;
            normal_bottom)
                swaymsg "output ${OUT1} power off" 2>/dev/null
                echo "top_off" > "$DISPLAY_STATE_FILE"
                ;;
            top_off)
                display_stack_vertical
                swaymsg '[app_id="emulationstation"]' move to output "${OUT1}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                display_update_active "${OUT1}"
                echo "normal_top" > "$DISPLAY_STATE_FILE"
                ;;
            *)
                display_stack_vertical
                swaymsg '[app_id="emulationstation"]' move to output "${OUT1}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                display_update_active "${OUT1}"
                echo "normal_top" > "$DISPLAY_STATE_FILE"
                ;;
        esac
        ;;

    off)
        display_kill_mirror
        case "$STATE" in
            normal_top|normal_bottom|mirror)
                swaymsg "output ${OUT2} power on" 2>/dev/null
                swaymsg "output ${OUT2} pos 0 0" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' move to output "${OUT2}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                swaymsg "output ${OUT1} power off" 2>/dev/null
                display_update_active "${OUT2}"
                echo "top_off" > "$DISPLAY_STATE_FILE"
                ;;
            top_off)
                swaymsg "output ${OUT1} power on" 2>/dev/null
                swaymsg "output ${OUT1} pos 0 0" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' move to output "${OUT1}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                swaymsg "output ${OUT2} power off" 2>/dev/null
                display_update_active "${OUT1}"
                echo "bottom_off" > "$DISPLAY_STATE_FILE"
                ;;
            bottom_off)
                display_stack_vertical
                swaymsg '[app_id="emulationstation"]' move to output "${OUT1}" 2>/dev/null
                swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
                display_update_active "${OUT1}"
                echo "normal_top" > "$DISPLAY_STATE_FILE"
                ;;
        esac
        ;;

    mirror)
        if [ "$STATE" = "mirror" ]; then
            # If wl-mirror running, cycle scaling instead of toggling off
            if display_cycle_mirror_scale; then
                exit 0
            fi
            # Mirror off
            display_kill_mirror
            display_stack_vertical
            swaymsg '[app_id="emulationstation"]' move to output "${OUT1}" 2>/dev/null
            swaymsg '[app_id="emulationstation"]' fullscreen enable 2>/dev/null
            display_update_active "${OUT1}"
            echo "normal_top" > "$DISPLAY_STATE_FILE"
        else
            # Mirror on — auto-select best method based on resolution,
            # transforms, and GPU driver capability
            display_mirror_auto '[app_id="emulationstation"]'
        fi
        ;;

    scale-top)
        display_cycle_scale top "$2" "$3"
        ;;

    scale-bottom)
        display_cycle_scale bottom "$2" "$3"
        ;;

    rotate-top)
        display_cycle_transform top
        ;;

    rotate-bottom)
        display_cycle_transform bottom
        ;;

    rotate-top-set)
        [ -n "$2" ] && display_set_transform top "$2"
        ;;

    rotate-bottom-set)
        [ -n "$2" ] && display_set_transform bottom "$2"
        ;;
esac
