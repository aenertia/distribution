cat <<EOF >/storage/.config/profile.d/010-governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0" "/sys/devices/system/cpu/cpufreq/policy2" "/sys/devices/system/cpu/cpufreq/policy5" "/sys/devices/system/cpu/cpufreq/policy7")
GPU_FREQ=("/sys/devices/platform/soc@0/3d00000.gpu/devfreq/3d00000.gpu")

# Uclamp tier scale — flagship ARMv9
UCLAMP_LIGHT=0
UCLAMP_MEDIUM=128
UCLAMP_HEAVY=256
UCLAMP_VERY_HEAVY=384
UCLAMP_EMU_MIN=200
UCLAMP_EMU_MAX=1024
UCLAMP_BG_MIN=0
UCLAMP_BG_MAX=20
EOF
