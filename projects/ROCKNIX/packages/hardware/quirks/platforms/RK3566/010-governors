cat <<EOF >/storage/.config/profile.d/010-governors
# FREQ governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0")
GPU_FREQ=("/sys/devices/platform/fde60000.gpu/devfreq/fde60000.gpu")
DMC_FREQ=("/sys/class/devfreq/memory-controller")
EOF

# Set TEO CPU idle governor if available
if [ -f /sys/devices/system/cpu/cpuidle/current_governor ]; then
  echo teo > /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null
fi

# Set schedutil as default CPU governor
echo schedutil > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null

# Re-toggle boost to update capacity_freq_ref for schedutil
# (kernel sets capacity_freq_ref at policy creation before boost OPPs are added)
if [ "$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null)" = "1" ]; then
  echo 0 > /sys/devices/system/cpu/cpufreq/boost
  echo 1 > /sys/devices/system/cpu/cpufreq/boost
fi
