cat <<'EOF' >/storage/.config/profile.d/010-governors
# FREQ governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0")
GPU_FREQ=("/sys/devices/platform/ff400000.gpu/devfreq/ff400000.gpu")
DMC_FREQ=("/sys/class/devfreq/memory-controller")

# Apply governor settings (runs at session start when sysfs is ready)
if [ -f /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ]; then
  # Schedutil required for boost/turbo-mode (default 'performance' wastes power)
  for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    echo schedutil > "${policy}/scaling_governor" 2>/dev/null
  done
  # Enable CPU boost — A35 turbo at 1416 MHz (px30.dtsi OPP table)
  echo 1 > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null
fi
EOF

# Set TEO CPU idle governor (available early, before cpufreq)
if [ -f /sys/devices/system/cpu/cpuidle/current_governor ]; then
  echo teo > /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null
fi
