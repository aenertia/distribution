--- a/drivers/mfd/rk8xx-core.c	2026-03-19 10:13:39.917336406 +1300
+++ b/drivers/mfd/rk8xx-core.c	2026-03-19 11:03:45.454106034 +1300
@@ -16,9 +16,39 @@
 #include <linux/mfd/core.h>
 #include <linux/module.h>
 #include <linux/property.h>
+#include <linux/delay.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/regmap.h>
 #include <linux/reboot.h>
 
+/*
+ * Lazy pinctrl acquisition for RK817/RK809 SLPPIN.
+ * Called on first shutdown - NOT at probe time.
+ */
+static void rk817_pinctrl_lazy_init(struct rk808 *rk808)
+{
+	struct pinctrl *p;
+
+	if (rk808->pctrl_loaded)
+		return;
+
+	rk808->pctrl_loaded = true;
+
+	p = pinctrl_get(rk808->dev);
+	if (IS_ERR_OR_NULL(p))
+		return;
+
+	rk808->pctrl = p;
+
+	rk808->pins_pwroff = pinctrl_lookup_state(p, "pmic-power-off");
+	if (IS_ERR(rk808->pins_pwroff))
+		rk808->pins_pwroff = NULL;
+
+	if (rk808->pins_pwroff)
+		dev_info(rk808->dev, "PMIC pinctrl: power-off=yes\n");
+}
+
+
 struct rk808_reg_data {
 	int addr;
 	int mask;
@@ -747,10 +777,35 @@
 		break;
 	case RK809_ID:
 	case RK817_ID:
+		rk817_pinctrl_lazy_init(rk808);
+
+		/* Disable OTG switch to cut USB VBUS before poweroff */
+		regmap_update_bits(rk808->regmap,
+				   RK817_POWER_EN_REG(3),
+				   BIT(2) | BIT(6), BIT(6));
+		mdelay(1);
+
+		if (rk808->pins_pwroff) {
+			regmap_update_bits(rk808->regmap,
+					   RK817_SYS_CFG(3),
+					   RK817_SLPPIN_FUNC_MSK,
+					   SLPPIN_NULL_FUN);
+			mdelay(2);
+
+			regmap_update_bits(rk808->regmap,
+					   RK817_SYS_CFG(3),
+					   RK817_SLPPOL_MSK,
+					   RK817_SLPPOL_H);
+
+			pinctrl_select_state(rk808->pctrl,
+					     rk808->pins_pwroff);
+		}
+
 		ret = regmap_update_bits(rk808->regmap,
 					 RK817_SYS_CFG(3),
 					 RK817_SLPPIN_FUNC_MSK,
 					 SLPPIN_DN_FUN);
+		mdelay(2);
 		break;
 	default:
 		return;
