--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -264,6 +264,14 @@ static u32 dw_mci_prepare_command(struct
 	    (cmd->opcode == SD_IO_RW_DIRECT &&
 	     ((cmd->arg >> 9) & 0x1FFFF) == SDIO_CCCR_ABORT))
 		cmdr |= SDMMC_CMD_STOP;
+	else if (cmd->opcode == SD_IO_RW_DIRECT)
+		/*
+		 * CMD52 has no data phase but must still wait for any
+		 * previous CMD53 data transfer to complete.  Without
+		 * this, CMD52 can collide with in-flight data on the
+		 * bus, corrupting controller state.
+		 */
+		cmdr |= SDMMC_CMD_PRV_DAT_WAIT;
 	else if (cmd->opcode != MMC_SEND_STATUS && cmd->data)
 		cmdr |= SDMMC_CMD_PRV_DAT_WAIT;

