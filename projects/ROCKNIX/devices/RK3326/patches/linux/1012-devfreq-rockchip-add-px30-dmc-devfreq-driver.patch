+	unsigned long			boot_rate;
+	int				post_resume_scale_down;
+	ktime_t				last_transition;
+};
+
+static struct px30_share_params *ddr_psci_param;
+static struct dmcfreq_wait_ctrl wait_ctrl;
+static struct pm_qos_request dmc_pm_qos;
+
+/* ---- SIP helpers ------------------------------------------------------ */
+
+static struct arm_smccc_res sip_smc_dram(unsigned long arg0,
+					 unsigned long arg1,
+					 unsigned long arg2)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(ROCKCHIP_SIP_DRAM_FREQ, arg0, arg1, arg2,
+		      0, 0, 0, 0, &res);
+	return res;
+}
+
+/* ---- De-skew register packing ----------------------------------------- */
+
+/*
+ * Pack per-bit de-skew values into the register format expected by ATF.
+ * Each pair of 4-bit values packs into one u32 word.
+ * Ported from BSP u-boot px30_de_skew_set_2_reg().
+ */
+static void px30_de_skew_set_2_reg(struct px30_ddr_de_skew_setting *de_skew,
+				   struct px30_ddr_dts_config_timing *tim)
+{
+	u32 n, offset, shift;
+
+	memset(tim->ca_skew, 0, sizeof(tim->ca_skew));
+	memset(tim->cs0_skew, 0, sizeof(tim->cs0_skew));
+	memset(tim->cs1_skew, 0, sizeof(tim->cs1_skew));
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->ca_de_skew); n++) {
+		offset = n / 2;
+		shift = (n % 2 == 0) ? 4 : 0;
+		tim->ca_skew[offset] &= ~(0xf << shift);
+		tim->ca_skew[offset] |= (de_skew->ca_de_skew[n] << shift);
+	}
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->cs0_de_skew); n++) {
+		offset = ((n / 21) * 11) + ((n % 21) / 2);
+		if ((n % 21) == 20)
+			shift = 0;
+		else
+			shift = ((n % 21) % 2 == 0) ? 4 : 0;
+		tim->cs0_skew[offset] &= ~(0xf << shift);
+		tim->cs0_skew[offset] |= (de_skew->cs0_de_skew[n] << shift);
+	}
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->cs1_de_skew); n++) {
+		offset = ((n / 21) * 11) + ((n % 21) / 2);
+		if ((n % 21) == 20)
+			shift = 0;
+		else
+			shift = ((n % 21) % 2 == 0) ? 4 : 0;
+		tim->cs1_skew[offset] &= ~(0xf << shift);
+		tim->cs1_skew[offset] |= (de_skew->cs1_de_skew[n] << shift);
+	}
+}
+
+/* ---- DTS timing parameter loading ------------------------------------- */
+
+/*
+ * Read DDR timing parameters from devicetree and write them to ATF
+ * shared memory at DTS_PAR_OFFSET.  If no timing node is present,
+ * shared memory is left zeroed (available=0) and ATF will use its
+ * boot-time defaults (no frequency scaling).
+ */
+static int px30_dmc_of_get_timings(struct device *dev)
+{
+	struct device_node *np_tim;
+	struct px30_ddr_dts_config_timing *dts_timing;
+	struct px30_ddr_de_skew_setting *de_skew;
+	u32 *p;
+	int ret = 0;
+	u32 i;
+
+	BUILD_BUG_ON(sizeof(struct px30_ddr_dts_config_timing) != 165 * 4);
+
+	np_tim = of_parse_phandle(dev->of_node, "rockchip,ddr-timing", 0);
+	if (!np_tim) {
+		dev_info(dev, "No rockchip,ddr-timing phandle — using ATF defaults\n");
+		return 0;
+	}
+
+	/* Allocate temporary structs in kernel memory, write to MMIO later */
+	dts_timing = kzalloc(sizeof(*dts_timing), GFP_KERNEL);
+	if (!dts_timing) {
+		of_node_put(np_tim);
+		return -ENOMEM;
+	}
+
+	de_skew = kzalloc(sizeof(*de_skew), GFP_KERNEL);
+	if (!de_skew) {
+		kfree(dts_timing);
+		of_node_put(np_tim);
+		return -ENOMEM;
+	}
+
+	/* Read 61 scalar timing properties */
+	p = (u32 *)dts_timing;
+	for (i = 0; i < ARRAY_SIZE(px30_dts_timing); i++)
+		ret |= of_property_read_u32(np_tim, px30_dts_timing[i], p + i);
+
+	/* Read de-skew properties (missing properties default to 0 from kzalloc) */
+	p = (u32 *)de_skew->ca_de_skew;
+	for (i = 0; i < ARRAY_SIZE(px30_dts_ca_timing); i++)
+		of_property_read_u32(np_tim, px30_dts_ca_timing[i], p + i);
+
+	p = (u32 *)de_skew->cs0_de_skew;
+	for (i = 0; i < ARRAY_SIZE(px30_dts_cs0_timing); i++)
+		of_property_read_u32(np_tim, px30_dts_cs0_timing[i], p + i);
+
+	p = (u32 *)de_skew->cs1_de_skew;
+	for (i = 0; i < ARRAY_SIZE(px30_dts_cs1_timing); i++)
+		of_property_read_u32(np_tim, px30_dts_cs1_timing[i], p + i);
+
+	of_node_put(np_tim);
+
+	/* Pack de-skew into register format */
+	px30_de_skew_set_2_reg(de_skew, dts_timing);
+	kfree(de_skew);
+
+	if (ret) {
+		dev_warn(dev, "Some timing properties missing — check DTS\n");
+		dts_timing->available = 0;
+	} else {
+		dts_timing->available = 1;
+	}
+
+	/* Write timing struct to page 2 of shared memory */
+	memcpy_toio((void __iomem *)ddr_psci_param + DTS_PAR_OFFSET,
+		    dts_timing, sizeof(*dts_timing));
+
+	dev_info(dev, "DDR timing: available=%u, pd_idle=%u, sr_idle=%u\n",
+		 dts_timing->available, dts_timing->pd_idle,
+		 dts_timing->sr_idle);
+
+	kfree(dts_timing);
+	return 0;
+}
+
+/* ---- MCU completion IRQ & wait logic ---------------------------------- */
+
+static irqreturn_t px30_wait_dcf_complete_irq(int irqno, void *dev_id)
+{
+	struct dmcfreq_wait_ctrl *ctrl = dev_id;
+	struct arm_smccc_res res;
+
+	res = sip_smc_dram(SHARE_PAGE_TYPE_DDR, 0,
+			   PX30_SIP_DRAM_POST_SET_RATE);
+	if (res.a0)
+		pr_err("px30-dmc: POST_SET_RATE error: %lx\n", res.a0);
+
+	ctrl->wait_flag = 0;
+	wake_up(&ctrl->wait_wq);
+	return IRQ_HANDLED;
+}
+
+static int px30_dmcfreq_wait_complete(void)
+{
+	struct arm_smccc_res res;
+
+	if (!wait_ctrl.wait_en)
+		return 0;
+
+	wait_ctrl.wait_flag = -1;
+	enable_irq(wait_ctrl.complt_irq);
+
+	/* Keep CPUs in WFI (not deep idle) so the FIQ fires promptly */
+	cpu_latency_qos_update_request(&dmc_pm_qos, 0);
+
+	res = sip_smc_dram(0, 0, PX30_SIP_DRAM_MCU_START);
+	if (res.a0) {
+		pr_err("px30-dmc: MCU_START error: %lx\n", res.a0);
+		goto out;
+	}
+
+	wait_event_timeout(wait_ctrl.wait_wq,
+			   wait_ctrl.wait_flag == 0,
+			   msecs_to_jiffies(wait_ctrl.wait_time_out_ms));
+
+	if (wait_ctrl.wait_flag != 0) {
+		pr_warn("px30-dmc: MCU completion timed out, forcing POST_SET_RATE\n");
+		res = sip_smc_dram(SHARE_PAGE_TYPE_DDR, 0,
+				   PX30_SIP_DRAM_POST_SET_RATE);
+		if (res.a0)
+			pr_err("px30-dmc: POST_SET_RATE error: %lx\n",
+			       res.a0);
+	}
+
+out:
+	cpu_latency_qos_update_request(&dmc_pm_qos, PM_QOS_DEFAULT_VALUE);
+	disable_irq(wait_ctrl.complt_irq);
+
+	return 0;
+}
+
+/* ---- Rate setting ----------------------------------------------------- */
+
+static int px30_dmc_set_rate(unsigned long target_rate)
+{
+	struct arm_smccc_res res;
+
+	ddr_psci_param->hz = target_rate;
+	ddr_psci_param->lcdc_type = 0;
+	ddr_psci_param->wait_flag1 = 1;
+	ddr_psci_param->wait_flag0 = 1;
+
+	res = sip_smc_dram(SHARE_PAGE_TYPE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_SET_RATE);
+
+	if ((int)res.a1 == SIP_RET_SET_RATE_TIMEOUT)
+		px30_dmcfreq_wait_complete();
+
+	return res.a0;
+}
+
+/* ---- devfreq callbacks ------------------------------------------------ */
+
+static int px30_dmcfreq_target(struct device *dev, unsigned long *freq,
+			       u32 flags)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+	unsigned long target_rate, target_volt, old_rate;
+	int err;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	target_rate = dev_pm_opp_get_freq(opp);
+	target_volt = dev_pm_opp_get_voltage(opp);
+	dev_pm_opp_put(opp);
+
+	if (dmcfreq->rate == target_rate)
+		return 0;
+
+	if (ktime_ms_delta(ktime_get(), dmcfreq->last_transition) <
+	    DMC_TRANSITION_COOLDOWN_MS)
+		return 0;
+
+	mutex_lock(&dmcfreq->lock);
+	old_rate = dmcfreq->rate;
+
+	if (target_rate > old_rate) {
+		err = regulator_set_voltage(dmcfreq->vdd_center,
+					    target_volt, target_volt);
+		if (err) {
+			dev_err(dev, "Cannot set voltage %lu uV\n",
+				target_volt);
+			goto unlock;
+		}
+	}
+
+	err = px30_dmc_set_rate(target_rate);
+	if (err) {
+		dev_err(dev, "Cannot set DDR rate %lu Hz (%d)\n",
+			target_rate, err);
+		if (target_rate > old_rate)
+			regulator_set_voltage(dmcfreq->vdd_center,
+					      dmcfreq->volt, dmcfreq->volt);
+		goto unlock;
+	}
+
+	if (target_rate < old_rate) {
+		err = regulator_set_voltage(dmcfreq->vdd_center,
+					    target_volt, target_volt);
+		if (err)
+			dev_err(dev, "Cannot set voltage %lu uV\n",
+				target_volt);
+	}
+
+	dmcfreq->rate = target_rate;
+	dmcfreq->volt = target_volt;
+	dmcfreq->last_transition = ktime_get();
+	err = 0;
+
+unlock:
+	mutex_unlock(&dmcfreq->lock);
+	return err;
+}
+
+static int px30_dmcfreq_get_dev_status(struct device *dev,
+				       struct devfreq_dev_status *stat)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct devfreq_event_data edata;
+	int ret;
+
+	stat->current_frequency = dmcfreq->rate;
+
+	if (dmcfreq->post_resume_scale_down > 0) {
+		dmcfreq->post_resume_scale_down--;
+		devfreq_event_get_event(dmcfreq->edev, &edata);
+		stat->busy_time = 0;
+		stat->total_time = 1;
+		return 0;
+	}
+
+	ret = devfreq_event_get_event(dmcfreq->edev, &edata);
+	if (ret < 0)
+		return ret;
+
+	if (edata.total_count == 0) {
+		stat->busy_time = 2;
+		stat->total_time = 10;
+		return 0;
+	}
+
+	stat->busy_time = edata.load_count;
+	stat->total_time = edata.total_count;
+
+	return 0;
+}
+
+static int px30_dmcfreq_get_cur_freq(struct device *dev, unsigned long *freq)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+
+	*freq = dmcfreq->rate;
+	return 0;
+}
+
+static struct devfreq_dev_profile px30_devfreq_profile = {
+	.polling_ms	= 200,
+	.target		= px30_dmcfreq_target,
+	.get_dev_status	= px30_dmcfreq_get_dev_status,
+	.get_cur_freq	= px30_dmcfreq_get_cur_freq,
+};
+
+/* ---- Suspend / resume ------------------------------------------------- */
+
+static int px30_dmcfreq_suspend(struct device *dev)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+	unsigned long target_volt;
+	unsigned long freq;
+
+	if (!dmcfreq->devfreq)
+		return 0;
+
+	mutex_lock(&dmcfreq->lock);
+	if (dmcfreq->rate != dmcfreq->boot_rate) {
+		freq = dmcfreq->boot_rate;
+		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+		if (!IS_ERR(opp)) {
+			target_volt = dev_pm_opp_get_voltage(opp);
+			dev_pm_opp_put(opp);
+			if (target_volt > dmcfreq->volt)
+				regulator_set_voltage(dmcfreq->vdd_center,
+						      target_volt, target_volt);
+			px30_dmc_set_rate(dmcfreq->boot_rate);
+			if (target_volt < dmcfreq->volt)
+				regulator_set_voltage(dmcfreq->vdd_center,
+						      target_volt, target_volt);
+			dmcfreq->rate = dmcfreq->boot_rate;
+			dmcfreq->volt = target_volt;
+		}
+	}
+
+	if (ddr_psci_param) {
+		ddr_psci_param->hz = 0;
+		ddr_psci_param->wait_flag1 = 0;
+		ddr_psci_param->wait_flag0 = 0;
+	}
+	mutex_unlock(&dmcfreq->lock);
+
+	return 0;
+}
+
+static int px30_dmcfreq_resume(struct device *dev)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+
+	if (!dmcfreq->devfreq)
+		return 0;
+
+	dmcfreq->rate = clk_get_rate(dmcfreq->dmc_clk);
+	dmcfreq->post_resume_scale_down = 3;
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(px30_dmcfreq_pm,
+				px30_dmcfreq_suspend,
+				px30_dmcfreq_resume);
+
+/* ---- Probe / remove --------------------------------------------------- */
+
+static int px30_dmcfreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct px30_dmcfreq *data;
+	struct arm_smccc_res res;
+	struct dev_pm_opp *opp;
+	int complt_irq;
+	int ret;
+
+	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->dev = dev;
+	mutex_init(&data->lock);
+
+	/* 1. Check ATF version */
+	dev_info(dev, "probe: step 1 — GET_VERSION SIP call\n");
+	res = sip_smc_dram(0, 0, PX30_SIP_DRAM_GET_VERSION);
+	dev_info(dev, "probe: step 1 — ATF DDR version 0x%lx (a0=%ld)\n",
+		 res.a1, (long)res.a0);
+	if (res.a0 || res.a1 < PX30_ATF_VERSION_MIN) {
+		dev_err(dev, "ATF too old or unsupported (need >= 0x%x)\n",
+			PX30_ATF_VERSION_MIN);
+		return -ENXIO;
+	}
+
+	/* 2. Request shared memory from ATF (2 pages) */
+	dev_info(dev, "probe: step 2 — SIP_SHARE_MEM request\n");
+	arm_smccc_smc(ROCKCHIP_SIP_SHARE_MEM, 2, SHARE_PAGE_TYPE_DDR, 0,
+		      0, 0, 0, 0, &res);
+	dev_info(dev, "probe: step 2 — SHARE_MEM a0=%ld a1=0x%lx\n",
+		 (long)res.a0, res.a1);
+	if (res.a0 || !res.a1) {
+		dev_err(dev, "SIP_SHARE_MEM failed (a0=%ld a1=0x%lx)\n",
+			(long)res.a0, res.a1);
+		return -ENOMEM;
+	}
+	ddr_psci_param = ioremap(res.a1, 2 * PAGE_SIZE);
+	if (!ddr_psci_param) {
+		dev_err(dev, "Failed to ioremap shared memory at 0x%lx\n",
+			res.a1);
+		return -ENOMEM;
+	}
+	memset_io(ddr_psci_param, 0, 2 * PAGE_SIZE);
+	dev_info(dev, "probe: step 2 — shared memory mapped at 0x%lx\n",
+		 res.a1);
+
+	/* 3. Set up MCU-based DCF completion wait mechanism */
+	dev_info(dev, "probe: step 3 — IRQ setup\n");
+	init_waitqueue_head(&wait_ctrl.wait_wq);
+	wait_ctrl.wait_en = 1;
+	wait_ctrl.wait_time_out_ms = 17 * 5;	/* ~85 ms (BSP value) */
+
+	complt_irq = platform_get_irq_byname(pdev, "complete_irq");
+	if (complt_irq < 0) {
+		dev_err(dev, "No 'complete_irq' IRQ: %d\n", complt_irq);
+		ret = complt_irq;
+		goto err_unmap;
+	}
+	wait_ctrl.complt_irq = complt_irq;
+	dev_info(dev, "probe: step 3 — complete_irq=%d\n", complt_irq);
+
+	ret = devm_request_irq(dev, complt_irq, px30_wait_dcf_complete_irq,
+			       0, dev_name(dev), &wait_ctrl);
+	if (ret < 0) {
+		dev_err(dev, "Cannot request complete IRQ: %d\n", ret);
+		goto err_unmap;
+	}
+	disable_irq(complt_irq);
+
+	/* 3.5 Store completion hwirq so ATF knows which GIC SPI to fire */
+	{
+		struct irq_data *irqd = irq_get_irq_data(complt_irq);
+		u32 hwirq = irqd ? irqd_to_hwirq(irqd) : 0;
+
+		ddr_psci_param->complt_hwirq = hwirq;
+		dev_info(dev, "probe: step 3.5 — complt_hwirq=%u\n", hwirq);
+	}
+
+	/* 3.6 Load DDR timing parameters from DTS into shared memory */
+	dev_info(dev, "probe: step 3.6 — loading DDR timing from DTS\n");
+	ret = px30_dmc_of_get_timings(dev);
+	if (ret) {
+		dev_err(dev, "Failed to load DDR timings: %d\n", ret);
+		goto err_unmap;
+	}
+
+	/* 4. Initialize DRAM scaling in ATF */
+	dev_info(dev, "probe: step 4 — DRAM_INIT SIP call\n");
+	res = sip_smc_dram(SHARE_PAGE_TYPE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_INIT);
+	dev_info(dev, "probe: step 4 — DRAM_INIT returned a0=%ld\n",
+		 (long)res.a0);
+	if (res.a0) {
+		dev_err(dev, "DRAM_INIT failed: %lx\n", res.a0);
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	/* 5. Get device resources */
+	dev_info(dev, "probe: step 5 — getting resources\n");
+	data->vdd_center = devm_regulator_get(dev, "center");
+	if (IS_ERR(data->vdd_center)) {
+		ret = dev_err_probe(dev, PTR_ERR(data->vdd_center),
+				    "Cannot get regulator \"center\"\n");
+		goto err_unmap;
+	}
+
+	data->dmc_clk = devm_clk_get(dev, "dmc_clk");
+	if (IS_ERR(data->dmc_clk)) {
+		ret = dev_err_probe(dev, PTR_ERR(data->dmc_clk),
+				    "Cannot get clk dmc_clk\n");
+		goto err_unmap;
+	}
+
+	data->edev = devfreq_event_get_edev_by_phandle(dev,
+						       "devfreq-events", 0);
+	if (IS_ERR(data->edev)) {
+		ret = -EPROBE_DEFER;
+		goto err_unmap;
+	}
+	dev_info(dev, "probe: step 5 — resources OK (regulator, clk, dfi)\n");
+
+	/* 6. Read boot frequency from clock */
+	data->rate = clk_get_rate(data->dmc_clk);
+	data->boot_rate = data->rate;
+	dev_info(dev, "probe: step 6 — boot DDR rate: %lu Hz\n", data->rate);
+
+	/* 7. Load OPP table (trusted from DTS) */
+	dev_info(dev, "probe: step 7 — loading OPP table from DTS\n");
+	ret = devm_pm_opp_of_add_table(dev);
+	if (ret) {
+		dev_err(dev, "Invalid operating-points in DT\n");
+		goto err_unmap;
+	}
+
+	/* 7.5 Lock to boot rate — disable all OPPs except nearest to boot.
+	 * ATF SET_RATE crashes for untested frequencies.  Keep only the
+	 * boot OPP so performance governor is a safe no-op.  Userspace
+	 * can re-enable OPPs via sysfs once transitions are validated.
+	 */
+	{
+		struct dev_pm_opp *nearest_opp;
+		unsigned long rate, nearest_rate = 0;
+		unsigned long best_diff = ULONG_MAX, diff;
+
+		for (rate = 0; ; rate++) {
+			nearest_opp = dev_pm_opp_find_freq_ceil(dev, &rate);
+			if (IS_ERR(nearest_opp))
+				break;
+			dev_pm_opp_put(nearest_opp);
+			diff = (rate > data->boot_rate) ?
+				rate - data->boot_rate :
+				data->boot_rate - rate;
+			if (diff < best_diff) {
+				best_diff = diff;
+				nearest_rate = rate;
+			}
+		}
+		for (rate = 0; ; rate++) {
+			nearest_opp = dev_pm_opp_find_freq_ceil(dev, &rate);
+			if (IS_ERR(nearest_opp))
+				break;
+			dev_pm_opp_put(nearest_opp);
+			if (rate != nearest_rate) {
+				dev_pm_opp_disable(dev, rate);
+				dev_info(dev, "probe: OPP %lu Hz disabled (boot-lock)\n",
+					 rate);
+			}
+		}
+		dev_info(dev, "probe: step 7.5 — locked to boot OPP %lu Hz\n",
+			 nearest_rate);
+	}
+
+	/* 8. Initialize PM QoS for wait_complete */
+	cpu_latency_qos_add_request(&dmc_pm_qos, PM_QOS_DEFAULT_VALUE);
+
+	/* 9. Enable DFI event device */
+	ret = devfreq_event_enable_edev(data->edev);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable DFI event device\n");
+		goto err_qos;
+	}
+
+	/* 10. Resolve initial OPP */
+	opp = devfreq_recommended_opp(dev, &data->rate, 0);
+	if (IS_ERR(opp)) {
+		ret = PTR_ERR(opp);
+		goto err_edev;
+	}
+	data->rate = dev_pm_opp_get_freq(opp);
+	data->volt = dev_pm_opp_get_voltage(opp);
+	dev_pm_opp_put(opp);
+	dev_info(dev, "probe: step 10 — initial OPP: %lu Hz, %lu uV\n",
+		 data->rate, data->volt);
+
+	/* 11. Register devfreq (performance — safe for bringup) */
+	dev_info(dev, "probe: step 11 — registering devfreq (performance)\n");
+	px30_devfreq_profile.initial_freq = data->rate;
+
+	data->devfreq = devm_devfreq_add_device(dev,
+						&px30_devfreq_profile,
+						DEVFREQ_GOV_PERFORMANCE,
+						NULL);
+	if (IS_ERR(data->devfreq)) {
+		ret = PTR_ERR(data->devfreq);
+		dev_err(dev, "Failed to add devfreq device: %d\n", ret);
+		goto err_edev;
+	}
+
+	devm_devfreq_register_opp_notifier(dev, data->devfreq);
+	platform_set_drvdata(pdev, data);
+
+	dev_info(dev, "probe: COMPLETE — DDR devfreq enabled: %lu Hz, %lu uV\n",
+		 data->rate, data->volt);
+
+	return 0;
+
+err_edev:
+	devfreq_event_disable_edev(data->edev);
+err_qos:
+	cpu_latency_qos_remove_request(&dmc_pm_qos);
+err_unmap:
+	if (ddr_psci_param) {
+		iounmap(ddr_psci_param);
+		ddr_psci_param = NULL;
+	}
+	return ret;
+}
+
+static void px30_dmcfreq_remove(struct platform_device *pdev)
+{
+	struct px30_dmcfreq *dmcfreq = dev_get_drvdata(&pdev->dev);
+
+	if (dmcfreq->devfreq)
+		devfreq_event_disable_edev(dmcfreq->edev);
+
+	cpu_latency_qos_remove_request(&dmc_pm_qos);
+
+	if (ddr_psci_param) {
+		iounmap(ddr_psci_param);
+		ddr_psci_param = NULL;
+	}
+}
+
+static const struct of_device_id px30_dmcfreq_of_match[] = {
+	{ .compatible = "rockchip,px30-dmc" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, px30_dmcfreq_of_match);
+
+static struct platform_driver px30_dmcfreq_driver = {
+	.probe	= px30_dmcfreq_probe,
+	.remove	= px30_dmcfreq_remove,
+	.driver	= {
+		.name	= "px30-dmc",
+		.pm	= pm_sleep_ptr(&px30_dmcfreq_pm),
+		.of_match_table = px30_dmcfreq_of_match,
+	},
+};
+module_platform_driver(px30_dmcfreq_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("ROCKNIX contributors");
+MODULE_DESCRIPTION("PX30/RK3326 DMC devfreq driver");
