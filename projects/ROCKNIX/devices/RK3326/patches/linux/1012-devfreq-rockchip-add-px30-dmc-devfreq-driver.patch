From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <rocknix@rocknix.org>
Date: Fri, 07 Mar 2026 00:00:00 +0000
Subject: [PATCH] devfreq: rockchip: add PX30 DMC devfreq driver

Add a DMC (Dynamic Memory Controller) devfreq driver for PX30/RK3326.

DDR frequency scaling uses the BSP V2 SIP protocol with MCU-based DCF:
 1. Kernel populates DDR timing parameters in ATF shared memory
 2. Kernel writes target Hz to the shared page
 3. SET_RATE SIP call returns -6 (started, wait for MCU completion)
 4. Kernel starts the MCU via MCU_START SIP sub-command
 5. MCU performs the HWFFC and fires a completion IRQ
 6. IRQ handler calls POST_SET_RATE for cleanup

DDR timing parameters (drive strength, ODT, de-skew) are read from
a devicetree 'rockchip,ddr-timing' phandle and written to ATF shared
memory before DRAM_INIT, matching the BSP u-boot flow.

This protocol follows the Rockchip BSP DMC driver behaviour (ATF
version 0x103 or newer for PX30).

Signed-off-by: ROCKNIX <rocknix@rocknix.org>
---
--- a/drivers/devfreq/Kconfig
+++ b/drivers/devfreq/Kconfig
@@ -152,6 +152,21 @@
 	  It sets the frequency for the memory controller and reads the usage counts
 	  from hardware.

+
+config ARM_PX30_DMC_DEVFREQ
+	tristate "ARM PX30 DMC DEVFREQ Driver"
+	depends on (ARCH_ROCKCHIP && HAVE_ARM_SMCCC) || \
+		(COMPILE_TEST && HAVE_ARM_SMCCC)
+	select DEVFREQ_EVENT_ROCKCHIP_DFI
+	select DEVFREQ_GOV_SIMPLE_ONDEMAND
+	select DEVFREQ_GOV_PERFORMANCE
+	select PM_DEVFREQ_EVENT
+	help
+	  This adds the DEVFREQ driver for the PX30/RK3326 DMC (Dynamic
+	  Memory Controller).  DDR frequency scaling is performed via ATF
+	  using the BSP V2 shared-memory SIP protocol with MCU-based DCF
+	  completion.
+
 config ARM_SUN8I_A33_MBUS_DEVFREQ
 	tristate "sun8i/sun50i MBUS DEVFREQ Driver"
 	depends on ARCH_SUNXI || COMPILE_TEST
--- a/drivers/devfreq/Makefile
+++ b/drivers/devfreq/Makefile
@@ -14,6 +14,7 @@
 obj-$(CONFIG_ARM_IMX8M_DDRC_DEVFREQ)	+= imx8m-ddrc.o
 obj-$(CONFIG_ARM_MEDIATEK_CCI_DEVFREQ)	+= mtk-cci-devfreq.o
 obj-$(CONFIG_ARM_RK3399_DMC_DEVFREQ)	+= rk3399_dmc.o
+obj-$(CONFIG_ARM_PX30_DMC_DEVFREQ)	+= px30_dmc.o
 obj-$(CONFIG_ARM_SUN8I_A33_MBUS_DEVFREQ)	+= sun8i-a33-mbus.o
 obj-$(CONFIG_ARM_TEGRA_DEVFREQ)		+= tegra30-devfreq.o

diff --git a/drivers/devfreq/px30_dmc.c b/drivers/devfreq/px30_dmc.c
new file mode 100644
--- /dev/null
+++ b/drivers/devfreq/px30_dmc.c
@@ -0,0 +1,1122 @@
